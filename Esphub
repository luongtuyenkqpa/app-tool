local function MakeToggle(yOff, icon, lbl, init, cb)
    local row = N("Frame",{
        Size=UDim2.new(1,-16,0,46),
        Position=UDim2.new(0,8,0,yOff),
        BackgroundColor3=Color3.fromRGB(14,14,35),
        BorderSizePixel=0,ZIndex=2001,
    },Panel)
    C(row,10)

    N("TextLabel",{
        Size=UDim2.new(0.58,0,1,0),
        Position=UDim2.new(0,12,0,0),
        BackgroundTransparency=1,
        TextColor3=Color3.fromRGB(235,235,235),
        Font=Enum.Font.Gotham,TextSize=13,
        Text=icon.."  "..lbl,
        TextXAlignment=Enum.TextXAlignment.Left,
        ZIndex=2002,
    },row)

    local st = init
    local btn = N("TextButton",{
        Size=UDim2.new(0,65,0,34),
        Position=UDim2.new(1,-73,0.5,-17),
        BackgroundColor3=st and Color3.fromRGB(38,190,68) or Color3.fromRGB(140,28,28),
        TextColor3=Color3.fromRGB(255,255,255),
        Font=Enum.Font.GothamBold,
        Text=st and "BẬT" or "TẮT",TextSize=14,
        BorderSizePixel=0,AutoButtonColor=false,ZIndex=2002,
    },row)
    C(btn,17)

    local function tog()
        st=not st
        btn.Text=st and "BẬT" or "TẮT"
        TweenService:Create(btn,TweenInfo.new(0.1),{
            BackgroundColor3=st and Color3.fromRGB(38,190,68) or Color3.fromRGB(140,28,28)
        }):Play()
        cb(st)
    end
    btn.MouseButton1Click:Connect(tog)
    btn.TouchTap:Connect(tog)
    btn.Activated:Connect(tog)
end

