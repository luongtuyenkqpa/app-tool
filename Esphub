-- ============================
-- OPEN/CLOSE MENU
-- ============================
local function openMenu()
    MenuOpen = not MenuOpen
    Panel.Visible = MenuOpen
    if MenuOpen then
        local bx = MBtn.Position.X.Offset
        local by = MBtn.Position.Y.Offset
        local sw = Camera.ViewportSize.X
        local sh = Camera.ViewportSize.Y
        local px = (bx + 250 > sw) and math.max(0, bx-243) or (bx+68)
        local py = math.clamp(by, 10, sh - 375)
        Panel.Position = UDim2.new(0, px, 0, py)
    end
end

local function closeMenu()
    MenuOpen = false
    Panel.Visible = false
end

-- 3 event cho menu button
