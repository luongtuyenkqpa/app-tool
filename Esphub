local function NewDrawing(dtype, props)
    if not drawingSupported then return {Visible=false, Remove=function()end} end
    local ok2, d = pcall(Drawing.new, dtype)
    if not ok2 then return {Visible=false, Remove=function()end} end
    for k, v in pairs(props) do
        pcall(function() d[k] = v end)
    end
    return d
end

local function CreateESP(player)
    ESP_Objects[player] = {
        BoxTop    = NewDrawing("Line", {Thickness=CONFIG.BoxThickness, Color=CONFIG.BoxColor,    Visible=false}),
        BoxBottom = NewDrawing("Line", {Thickness=CONFIG.BoxThickness, Color=CONFIG.BoxColor,    Visible=false}),
        BoxLeft   = NewDrawing("Line", {Thickness=CONFIG.BoxThickness, Color=CONFIG.BoxColor,    Visible=false}),
        BoxRight  = NewDrawing("Line", {Thickness=CONFIG.BoxThickness, Color=CONFIG.BoxColor,    Visible=false}),
        NameTag   = NewDrawing("Text", {Size=14, Color=CONFIG.NameColor,    Center=true, Outline=true, OutlineColor=Color3.new(0,0,0), Visible=false, Font=2}),
        DistTag   = NewDrawing("Text", {Size=12, Color=CONFIG.DistanceColor, Center=true, Outline=true, OutlineColor=Color3.new(0,0,0), Visible=false, Font=2}),
    }
end

local function RemoveESP(player)
    if not ESP_Objects[player] then return end
    for _, d in pairs(ESP_Objects[player]) do
        pcall(function() d:Remove() end)
    end
    ESP_Objects[player] = nil
end

-- ============================
-- BOUNDING BOX
-- ============================
local function GetBoundingBox(character)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local cf = hrp.CFrame
    local pts = {
        cf*CFrame.new(-2, 2.8,0), cf*CFrame.new(2, 2.8,0),
        cf*CFrame.new(-2,-2.8,0), cf*CFrame.new(2,-2.8,0),
    }
    local x0,y0,x1,y1 = math.huge,math.huge,-math.huge,-math.huge
    local hit = false
    for _,c in ipairs(pts) do
        local s,v = Camera:WorldToViewportPoint(c.Position)
        if v then
            hit=true
            x0=math.min(x0,s.X) y0=math.min(y0,s.Y)
            x1=math.max(x1,s.X) y1=math.max(y1,s.Y)
        end
    end
    return hit and x0,y0,x1,y1 or nil
end

-- ============================
-- UPDATE LOOP
-- ============================
local function UpdateESP()
    EnemyCount = 0
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl == LocalPlayer then continue end
        if not ShowTeammates and pl.Team == LocalPlayer.Team then
            RemoveESP(pl); continue
        end
        if not ESP_Objects[pl] then CreateESP(pl) end

        local dr  = ESP_Objects[pl]
        local chr = pl.Character
        local hrp = chr and chr:FindFirstChild("HumanoidRootPart")
        local hum = chr and chr:FindFirstChildOfClass("Humanoid")

        if not ESP_Enabled or not chr or not hrp or not hum or hum.Health<=0 then
            for _,d in pairs(dr) do pcall(function() d.Visible=false end) end
            continue
        end

        local lhrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local dist = lhrp and (hrp.Position-lhrp.Position).Magnitude or 0
        if dist > CONFIG.MaxDistance then
            for _,d in pairs(dr) do pcall(function() d.Visible=false end) end
            continue
        end

        EnemyCount += 1
        local x0,y0,x1,y1 = GetBoundingBox(chr)
        if not x0 then
            for _,d in pairs(dr) do pcall(function() d.Visible=false end) end
            continue
        end

        local tl,tr=Vector2.new(x0,y0),Vector2.new(x1,y0)
        local bl,br=Vector2.new(x0,y1),Vector2.new(x1,y1)
        local bv = ShowBox and ESP_Enabled

        pcall(function()
            dr.BoxTop.From=tl    dr.BoxTop.To=tr    dr.BoxTop.Visible=bv
            dr.BoxBottom.From=bl dr.BoxBottom.To=br dr.BoxBottom.Visible=bv
            dr.BoxLeft.From=tl   dr.BoxLeft.To=bl   dr.BoxLeft.Visible=bv
            dr.BoxRight.From=tr  dr.BoxRight.To=br  dr.BoxRight.Visible=bv
            dr.NameTag.Position=Vector2.new((x0+x1)/2, y0-16)
            dr.NameTag.Text=pl.DisplayName
            dr.NameTag.Visible=ShowName and ESP_Enabled
            dr.DistTag.Position=Vector2.new((x0+x1)/2, y1+2)
            dr.DistTag.Text=string.format("[%.0f m]",dist)
            dr.DistTag.Visible=ShowDistance and ESP_Enabled
        end)
    end
    CounterLabel.Text = string.format("👁 Kẻ Địch: %d", EnemyCount)
end

