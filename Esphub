-- ============================
-- DRAG MENU BUTTON
-- ============================
do
    local drag, ds, bs, t0 = false, nil, nil, 0
    MBtn.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.Touch
        or i.UserInputType==Enum.UserInputType.MouseButton1 then
            drag=true ds=i.Position
            bs=MBtn.Position t0=tick()
        end
    end)
    MBtn.InputChanged:Connect(function(i)
        if not drag then return end
        if i.UserInputType==Enum.UserInputType.Touch
        or i.UserInputType==Enum.UserInputType.MouseMovement then
            local d=i.Position-ds
            if math.abs(d.X)>6 or math.abs(d.Y)>6 then
                MBtn.Position=UDim2.new(0,bs.X.Offset+d.X,0,bs.Y.Offset+d.Y)
            end
        end
    end)
    MBtn.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.Touch
        or i.UserInputType==Enum.UserInputType.MouseButton1 then
            drag=false
        end
    end)
end

