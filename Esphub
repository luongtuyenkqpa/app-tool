-- BILLBOARD ESP (thay Drawing)
-- ============================
local function GetOrCreate(player)
    if ESPCache[player] then return ESPCache[player] end
    local chr = player.Character
    local hrp = chr and chr:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    -- BillboardGui gắn vào HumanoidRootPart
    local bb = New("BillboardGui",{
        Size=UDim2.new(0,80,0,100),
        StudsOffset=Vector3.new(0,3,0),
        AlwaysOnTop=true,
        Active=false,
        ResetOnSpawn=false,
    },hrp)

    -- Tên
    local nameL = New("TextLabel",{
        Size=UDim2.new(1,0,0,18),
        Position=UDim2.new(0,0,0,0),
        BackgroundTransparency=1,
        TextColor3=CFG.NameColor,
        Font=Enum.Font.GothamBold,
        TextSize=14,
        Text=player.DisplayName,
        TextStrokeTransparency=0,
        TextStrokeColor3=Color3.new(0,0,0),
    },bb)

    -- Khoảng cách
    local distL = New("TextLabel",{
        Size=UDim2.new(1,0,0,16),
        Position=UDim2.new(0,0,1,-16),
        BackgroundTransparency=1,
        TextColor3=CFG.DistColor,
        Font=Enum.Font.GothamBold,
        TextSize=12,
        Text="",
        TextStrokeTransparency=0,
        TextStrokeColor3=Color3.new(0,0,0),
    },bb)

    -- Box outline (dùng Frame viền)
    local boxF = New("Frame",{
        Size=UDim2.new(1,0,1,-20),
        Position=UDim2.new(0,0,0,18),
        BackgroundTransparency=1,
        BorderSizePixel=0,
    },bb)
    New("UIStroke",{
        Color=CFG.BoxColor,
        Thickness=CFG.Thickness,
        ApplyStrokeMode=Enum.ApplyStrokeMode.Border,
    },boxF)

    ESPCache[player] = {bb=bb, nameL=nameL, distL=distL, boxF=boxF}
    return ESPCache[player]
end

local function RemoveESP(player)
    if not ESPCache[player] then return end
    pcall(function() ESPCache[player].bb:Destroy() end)
    ESPCache[player] = nil
end

-- ============================
-- UPDATE LOOP
-- ============================
local enemyCount = 0
RunService.RenderStepped:Connect(function()
    enemyCount = 0
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl == LocalPlayer then continue end

        local sameTeam = pl.Team == LocalPlayer.Team
        if not STATE.Teammate and sameTeam then
            RemoveESP(pl); continue
        end

        local chr = pl.Character
        local hrp = chr and chr:FindFirstChild("HumanoidRootPart")
        local hum = chr and chr:FindFirstChildOfClass("Humanoid")

        if not chr or not hrp or not hum or hum.Health <= 0 then
            RemoveESP(pl); continue
        end

        -- Khoảng cách
        local lhrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local dist = lhrp and (hrp.Position-lhrp.Position).Magnitude or 0
        if dist > CFG.MaxDist then
            RemoveESP(pl); continue
        end

        if not STATE.ESP then
            if ESPCache[pl] then
                pcall(function() ESPCache[pl].bb.Enabled = false end)
            end
            continue
        end

        local data = GetOrCreate(pl)
        if not data then continue end

        enemyCount += 1

        -- Cập nhật billboard
        pcall(function()
            data.bb.Enabled = true
            -- Tên
            data.nameL.Visible = STATE.Name
            data.nameL.Text = pl.DisplayName
            -- Dist
            data.distL.Visible = STATE.Dist
            data.distL.Text = string.format("[%.0f m]", dist)
            -- Box
            data.boxF.Visible = STATE.Box
        end)
    end
    CLabel.Text = string.format("👁  Kẻ Địch: %d", enemyCount)
end)

