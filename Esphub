-- ============================
-- DRAG + TAP LOGIC
-- ============================
do
    local dragging = false
    local dragStart, btnStart, t0

    MenuBtn.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.Touch
        or inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging  = true
            dragStart = inp.Position
            btnStart  = MenuBtn.Position
            t0        = tick()
        end
    end)

    MenuBtn.InputChanged:Connect(function(inp)
        if not dragging then return end
        if inp.UserInputType == Enum.UserInputType.Touch
        or inp.UserInputType == Enum.UserInputType.MouseMovement then
            local d = inp.Position - dragStart
            if math.abs(d.X) > 6 or math.abs(d.Y) > 6 then
                MenuBtn.Position = UDim2.new(
                    0, btnStart.X.Offset + d.X,
                    0, btnStart.Y.Offset + d.Y
                )
            end
        end
    end)

    local function tryToggleMenu(inp)
        if not dragging then return end
        local elapsed = tick() - (t0 or 0)
        local d = inp.Position - (dragStart or inp.Position)
        local moved = math.abs(d.X) + math.abs(d.Y)
        dragging = false

        if elapsed < 0.35 and moved < 15 then
            MenuOpen = not MenuOpen
            MenuPanel.Visible = MenuOpen
            if MenuOpen then
                local bx = MenuBtn.Position.X.Offset
                local by = MenuBtn.Position.Y.Offset
                local sw = Camera.ViewportSize.X
                local px = (bx + 290 > sw) and (bx - 238) or (bx + 65)
                local py = math.clamp(by, 10, Camera.ViewportSize.Y - 370)
                MenuPanel.Position = UDim2.new(0, px, 0, py)
            end
        end
    end

    MenuBtn.InputEnded:Connect(tryToggleMenu)
    MenuBtn.TouchTap:Connect(function()
        MenuOpen = not MenuOpen
        MenuPanel.Visible = MenuOpen
        if MenuOpen then
            local bx = MenuBtn.Position.X.Offset
            local by = MenuBtn.Position.Y.Offset
            local sw = Camera.ViewportSize.X
            local px = (bx + 290 > sw) and (bx - 238) or (bx + 65)
            local py = math.clamp(by, 10, Camera.ViewportSize.Y - 370)
            MenuPanel.Position = UDim2.new(0, px, 0, py)
        end
    end)
end

