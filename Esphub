ToggleBtn.MouseButton1Click:Connect(function()
    ESP_Enabled = not ESP_Enabled
    if ESP_Enabled then
        ToggleBtn.Text = "ESP: BẬT"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
    else
        ToggleBtn.Text = "ESP: TẮT"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
        -- Xóa hết drawings
        for _, obj in pairs(ESP_Objects) do
            for _, drawing in pairs(obj) do
                if drawing.Remove then drawing:Remove() end
            end
        end
        ESP_Objects = {}
    end
end)

ScreenGui.Parent = game:GetService("CoreGui")

-- ============================
-- DRAWING HELPERS
-- ============================
local function NewDrawing(type, props)
    local d = Drawing.new(type)
    for k, v in pairs(props) do
        d[k] = v
    end
    return d
end

local function CreateESP(player)
    local drawings = {
        -- Box (4 lines)
        BoxTop    = NewDrawing("Line", { Thickness = CONFIG.BoxThickness, Color = CONFIG.BoxColor, Visible = false }),
        BoxBottom = NewDrawing("Line", { Thickness = CONFIG.BoxThickness, Color = CONFIG.BoxColor, Visible = false }),
        BoxLeft   = NewDrawing("Line", { Thickness = CONFIG.BoxThickness, Color = CONFIG.BoxColor, Visible = false }),
        BoxRight  = NewDrawing("Line", { Thickness = CONFIG.BoxThickness, Color = CONFIG.BoxColor, Visible = false }),
        -- Name
        NameTag   = NewDrawing("Text", { Size = 14, Color = CONFIG.NameColor, Center = true, Outline = true, OutlineColor = Color3.new(0,0,0), Visible = false, Font = 2 }),
        -- Distance
        DistTag   = NewDrawing("Text", { Size = 12, Color = CONFIG.DistanceColor, Center = true, Outline = true, OutlineColor = Color3.new(0,0,0), Visible = false, Font = 2 }),
    }
    ESP_Objects[player] = drawings
end

local function RemoveESP(player)
    if ESP_Objects[player] then
        for _, d in pairs(ESP_Objects[player]) do
            if d.Remove then d:Remove() end
        end
        ESP_Objects[player] = nil
    end
end

-- ============================
-- WORLD TO SCREEN
-- ============================
local function GetBoundingBox(character)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local size = Vector3.new(4, 5.5, 0)
    local cf = hrp.CFrame

    local corners = {
        cf * CFrame.new(-size.X/2,  size.Y/2, 0),
        cf * CFrame.new( size.X/2,  size.Y/2, 0),
        cf * CFrame.new(-size.X/2, -size.Y/2, 0),
        cf * CFrame.new( size.X/2, -size.Y/2, 0),
    }

    local minX, minY = math.huge, math.huge
    local maxX, maxY = -math.huge, -math.huge
    local onScreen = false

    for _, c in ipairs(corners) do
        local screen, vis = Camera:WorldToViewportPoint(c.Position)
        if vis then
            onScreen = true
            minX = math.min(minX, screen.X)
            minY = math.min(minY, screen.Y)
            maxX = math.max(maxX, screen.X)
            maxY = math.max(maxY, screen.Y)
        end
    end

    if not onScreen then return nil end
    return minX, minY, maxX, maxY
end

-- ============================
-- UPDATE LOOP
-- ============================
local function UpdateESP()
    EnemyCount = 0

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end

        -- Team check (tuỳ chọn)
        if CONFIG.TeamCheck and player.Team == LocalPlayer.Team then
            RemoveESP(player)
            continue
        end

        local character = player.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")

        if not ESP_Objects[player] then
            CreateESP(player)
        end

        local drawings = ESP_Objects[player]

        if not ESP_Enabled or not character or not hrp
            or not humanoid or humanoid.Health <= 0 then
            for _, d in pairs(drawings) do d.Visible = false end
            continue
        end

        -- Khoảng cách
        local lhrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local dist = lhrp and (hrp.Position - lhrp.Position).Magnitude or 0

        if dist > CONFIG.MaxDistance then
            for _, d in pairs(drawings) do d.Visible = false end
            continue
        end

        EnemyCount = EnemyCount + 1

        local minX, minY, maxX, maxY = GetBoundingBox(character)

        if not minX then
            for _, d in pairs(drawings) do d.Visible = false end
            continue
        end

        local tl = Vector2.new(minX, minY)
        local tr = Vector2.new(maxX, minY)
        local bl = Vector2.new(minX, maxY)
        local br = Vector2.new(maxX, maxY)

        -- Vẽ Box
        if CONFIG.ShowBox then
            drawings.BoxTop.From    = tl; drawings.BoxTop.To    = tr; drawings.BoxTop.Visible    = true
            drawings.BoxBottom.From = bl; drawings.BoxBottom.To = br; drawings.BoxBottom.Visible = true
            drawings.BoxLeft.From   = tl; drawings.BoxLeft.To   = bl; drawings.BoxLeft.Visible   = true
            drawings.BoxRight.From  = tr; drawings.BoxRight.To  = br; drawings.BoxRight.Visible  = true
        end

        -- Tên
        if CONFIG.ShowName then
            drawings.NameTag.Position = Vector2.new((minX + maxX) / 2, minY - 16)
            drawings.NameTag.Text = player.DisplayName
            drawings.NameTag.Visible = true
        end

        -- Khoảng cách
        if CONFIG.ShowDistance then
            drawings.DistTag.Position = Vector2.new((minX + maxX) / 2, maxY + 2)
            drawings.DistTag.Text = string.format("[%.0f m]", dist)
            drawings.DistTag.Visible = true
        end
    end

    -- Cập nhật counter
    CounterLabel.Text = string.format("👁 Kẻ Địch: %d", EnemyCount)
end

-- ============================
-- PLAYER EVENTS
-- ============================
Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function()
        RemoveESP(p)
    end)
end)

Players.PlayerRemoving:Connect(function(p)
    RemoveESP(p)
end)

-- ============================
-- MAIN LOOP
-- ============================
RunService.RenderStepped:Connect(function()
    if ESP_Enabled then
        UpdateESP()
    end
end)

print("✅ ESP Chameleon loaded! Toggle bằng nút trên màn hình.")
