-- Thử parent theo thứ tự ưu tiên
local function TryParent(gui)
    local targets = {
        function() return game:GetService("CoreGui") end,
        function() return LocalPlayer:WaitForChild("PlayerGui", 3) end,
    }
    for _, fn in ipairs(targets) do
        local ok, target = pcall(fn)
        if ok and target then
            local ok2 = pcall(function() gui.Parent = target end)
            if ok2 and gui.Parent then
                warn("✅ GUI parented to: " .. target.Name)
                return true
            end
        end
    end
    return false
end

if not TryParent(SG) then
    SG.Parent = game:GetService("CoreGui")
end

