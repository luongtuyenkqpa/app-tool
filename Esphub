local function MakeToggle(yOff, icon, label, init, cb)
    local row = New("Frame",{
        Size=UDim2.new(1,-18,0,44),
        Position=UDim2.new(0,9,0,yOff),
        BackgroundColor3=Color3.fromRGB(16,16,38),
        BorderSizePixel=0, ZIndex=2001,
    },Panel)
    Corner(row,10)

    New("TextLabel",{
        Size=UDim2.new(0.6,0,1,0),
        Position=UDim2.new(0,10,0,0),
        BackgroundTransparency=1,
        TextColor3=Color3.fromRGB(235,235,235),
        Font=Enum.Font.Gotham,
        TextSize=13,
        Text=icon.."  "..label,
        TextXAlignment=Enum.TextXAlignment.Left,
        ZIndex=2002,
    },row)

    local st = init
    local btn = New("TextButton",{
        Size=UDim2.new(0,62,0,32),
        Position=UDim2.new(1,-70,0.5,-16),
        BackgroundColor3=st and Color3.fromRGB(40,195,70) or Color3.fromRGB(135,30,30),
        TextColor3=Color3.fromRGB(255,255,255),
        Font=Enum.Font.GothamBold,
        Text=st and "BẬT" or "TẮT",
        TextSize=13,
        BorderSizePixel=0,
        AutoButtonColor=false,
        ZIndex=2002,
    },row)
    Corner(btn,16)

    local function toggle()
        st = not st
        btn.Text = st and "BẬT" or "TẮT"
        TweenService:Create(btn, TweenInfo.new(0.12),{
            BackgroundColor3 = st and Color3.fromRGB(40,195,70) or Color3.fromRGB(135,30,30)
        }):Play()
        cb(st)
    end

    -- Dùng cả 3 event để đảm bảo bắt được trên mọi executor
    btn.MouseButton1Click:Connect(toggle)
    btn.TouchTap:Connect(toggle)
    btn.Activated:Connect(toggle)
end

