-- ESP Script for Chameleon (Roblox)
-- Features: Enemy ESP Box, Name Tag, Distance, Counter
-- Compatible with Synapse X, KRNL, Fluxus, Delta

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Camera = workspace.CurrentCamera

local LocalPlayer = Players.LocalPlayer
local ESP_Enabled = true
local ESP_Objects = {}
local EnemyCount = 0

-- ============================
-- CONFIG
-- ============================
local CONFIG = {
    BoxColor      = Color3.fromRGB(255, 50, 50),    -- Màu box kẻ địch
    NameColor     = Color3.fromRGB(255, 255, 255),  -- Màu tên
    DistanceColor = Color3.fromRGB(255, 200, 0),    -- Màu khoảng cách
    CounterColor  = Color3.fromRGB(0, 255, 100),    -- Màu bộ đếm
    BoxThickness  = 1.5,
    ShowBox       = true,
    ShowName      = true,
    ShowDistance  = true,
    ShowCounter   = true,
    MaxDistance   = 1000,
    TeamCheck     = false, -- true = chỉ highlight team khác
}

-- ============================
-- GUI COUNTER (góc màn hình)
-- ============================
