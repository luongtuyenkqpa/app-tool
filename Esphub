-- OPEN / CLOSE LOGIC
-- ============================
local function CalcPanelPos()
    local bx = MBtn.Position.X.Offset
    local by = MBtn.Position.Y.Offset
    local sw = Camera.ViewportSize.X
    local sh = Camera.ViewportSize.Y
    local px = (bx + 260 > sw) and math.max(4, bx - 248) or (bx + 70)
    local py = math.clamp(by, 10, sh - 380)
    return UDim2.new(0, px, 0, py)
end

local function OpenMenu()
    MenuOpen = not MenuOpen
    Panel.Visible = MenuOpen
    if MenuOpen then
        Panel.Position = CalcPanelPos()
        -- Animate
        Panel.BackgroundTransparency = 1
        TweenService:Create(Panel, TweenInfo.new(0.18), {
            BackgroundTransparency = 0
        }):Play()
    end
end

local function CloseMenu()
    MenuOpen = false
    Panel.Visible = false
end

