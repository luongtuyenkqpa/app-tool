-- ============================
-- DRAG MENU BUTTON
-- ============================
do
    local drag, ds, bs = false, nil, nil
    MBtn.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch
        or i.UserInputType == Enum.UserInputType.MouseButton1 then
            drag = true
            ds   = i.Position
            bs   = MBtn.Position
        end
    end)
    MBtn.InputChanged:Connect(function(i)
        if not drag then return end
        if i.UserInputType == Enum.UserInputType.Touch
        or i.UserInputType == Enum.UserInputType.MouseMovement then
            local d = i.Position - ds
            if math.abs(d.X) > 5 or math.abs(d.Y) > 5 then
                MBtn.Position = UDim2.new(0, bs.X.Offset+d.X, 0, bs.Y.Offset+d.Y)
                if MenuOpen then
                    Panel.Position = CalcPanelPos()
                end
            end
        end
    end)
    MBtn.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch
        or i.UserInputType == Enum.UserInputType.MouseButton1 then
            drag = false
        end
    end)
end

-- ============================
-- BILLBOARD ESP
-- ============================
local function GetESP(player)
    if Cache[player] then return Cache[player] end
    local chr = player.Character
    local hrp = chr and chr:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    -- Xóa cái cũ nếu có
    local old = hrp:FindFirstChild("ESP_BB")
    if old then old:Destroy() end

    local bb = New("BillboardGui", {
        Name="ESP_BB",
        Size=UDim2.new(0, 90, 0, 115),
        StudsOffset=Vector3.new(0, 3.2, 0),
        AlwaysOnTop=true,
        Active=false,
        ResetOnSpawn=false,
        Enabled=true,
    }, hrp)

    -- Tên player
    local nameL = New("TextLabel", {
        Size=UDim2.new(1,0,0,20),
        Position=UDim2.new(0,0,0,0),
        BackgroundTransparency=1,
        TextColor3=CFG.NameColor,
        Font=Enum.Font.GothamBold,
        TextSize=15,
        Text=player.DisplayName,
        TextStrokeTransparency=0.4,
        TextStrokeColor3=Color3.new(0,0,0),
    }, bb)

    -- Khoảng cách
    local distL = New("TextLabel", {
        Size=UDim2.new(1,0,0,18),
        Position=UDim2.new(0,0,1,-18),
        BackgroundTransparency=1,
        TextColor3=CFG.DistColor,
        Font=Enum.Font.GothamBold,
        TextSize=13,
        Text="",
        TextStrokeTransparency=0.4,
        TextStrokeColor3=Color3.new(0,0,0),
    }, bb)

    -- Box (4 đường viền dùng Frame mỏng)
    local boxC = New("Frame", {
        Size=UDim2.new(1,0,1,-22),
        Position=UDim2.new(0,0,0,21),
        BackgroundTransparency=1,
        BorderSizePixel=0,
    }, bb)
    New("UIStroke", {
        Color=CFG.BoxColor,
        Thickness=2,
        ApplyStrokeMode=Enum.ApplyStrokeMode.Border,
    }, boxC)

    Cache[player] = {bb=bb, nameL=nameL, distL=distL, boxC=boxC}
    return Cache[player]
end

local function RemoveESP(player)
    if not Cache[player] then return end
    pcall(function() Cache[player].bb:Destroy() end)
    Cache[player] = nil
end

-- ============================
-- AUTO HOOK: gắn ESP khi character spawn
-- ============================
local function HookPlayer(player)
    -- Hook CharacterAdded
    player.CharacterAdded:Connect(function(chr)
        task.wait(0.8) -- Đợi character load xong
        RemoveESP(player)
    end)
    -- Nếu đã có character rồi
    if player.Character then
        -- ESP sẽ tự tạo trong UpdateESP
    end
end

-- Hook tất cả player hiện tại
for _, pl in ipairs(Players:GetPlayers()) do
    if pl ~= LocalPlayer then
        HookPlayer(pl)
    end
end

-- Hook player mới vào
Players.PlayerAdded:Connect(function(pl)
    HookPlayer(pl)
end)

Players.PlayerRemoving:Connect(RemoveESP)

-- ============================
-- UPDATE LOOP
-- ============================
local enemyN = 0
RunService.RenderStepped:Connect(function()
    enemyN = 0

    for _, pl in ipairs(Players:GetPlayers()) do
        if pl == LocalPlayer then continue end

        -- Team filter
        local sameTeam = pl.Team ~= nil and pl.Team == LocalPlayer.Team
        if not STATE.Team and sameTeam then
            RemoveESP(pl); continue
        end

        local chr = pl.Character
        local hrp = chr and chr:FindFirstChild("HumanoidRootPart")
        local hum = chr and chr:FindFirstChildOfClass("Humanoid")

        -- Không có character hoặc đã chết
        if not chr or not hrp or not hum or hum.Health <= 0 then
            RemoveESP(pl); continue
        end

        -- Khoảng cách
        local lhrp = LocalPlayer.Character
            and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local dist = lhrp
            and (hrp.Position - lhrp.Position).Magnitude
            or 0

        if dist > CFG.MaxDist then
            RemoveESP(pl); continue
        end

        -- ESP tắt thì ẩn billboard
        if not STATE.ESP then
            if Cache[pl] then
                pcall(function() Cache[pl].bb.Enabled = false end)
            end
            continue
        end

        enemyN += 1

        local data = GetESP(pl)
        if not data then continue end

        pcall(function()
            data.bb.Enabled = true

            -- Tên
            data.nameL.Visible = STATE.Name
            data.nameL.Text = pl.DisplayName

            -- Dist
            data.distL.Visible = STATE.Dist
            data.distL.Text = string.format("[%.0f m]", dist)

            -- Box
            data.boxC.Visible = STATE.Box
        end)
    end

    CLabel.Text = string.format("👁  Kẻ Địch: %d", enemyN)
end)

