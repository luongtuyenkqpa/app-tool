local function Pos()
    local bx=MBtn.Position.X.Offset
    local by=MBtn.Position.Y.Offset
    local sw=Camera.ViewportSize.X
    local sh=Camera.ViewportSize.Y
    local px=(bx+260>sw) and math.max(4,bx-253) or (bx+72)
    local py=math.clamp(by,10,sh-390)
    return UDim2.new(0,px,0,py)
end

local function Open()
    MenuOpen=not MenuOpen
    Panel.Visible=MenuOpen
    if MenuOpen then Panel.Position=Pos() end
end
local function Close()
    MenuOpen=false Panel.Visible=false
end
local function DoClear()
    for _,d in pairs(Cache) do pcall(function() d.bb:Destroy() end) end
    Cache={}
    CLabel.Text="👁  Kẻ Địch: 0"
