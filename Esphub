-- ============================
-- DRAG MENU BUTTON (MOBILE FIX)
-- ============================
do
    local dragging = false
    local dragStartPos
    local btnStartPos
    local tapTime

    MenuBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStartPos = input.Position
            btnStartPos  = MenuBtn.Position
            tapTime      = tick()
        end
    end)

    MenuBtn.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStartPos
            -- Chỉ drag nếu di chuyển > 8px (phân biệt tap vs drag)
            if math.abs(delta.X) > 8 or math.abs(delta.Y) > 8 then
                MenuBtn.Position = UDim2.new(
                    btnStartPos.X.Scale,
                    btnStartPos.X.Offset + delta.X,
                    btnStartPos.Y.Scale,
                    btnStartPos.Y.Offset + delta.Y
                )
            end
        end
    end)

    MenuBtn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
            local elapsed = tick() - (tapTime or 0)
            local delta = input.Position - (dragStartPos or input.Position)
            local moved = math.abs(delta.X) + math.abs(delta.Y)

            -- Nếu là tap (< 0.3s và không di chuyển nhiều) → toggle menu
            if elapsed < 0.3 and moved < 12 then
                MenuOpen = not MenuOpen
                MenuPanel.Visible = MenuOpen

                if MenuOpen then
                    local bx = MenuBtn.Position.X.Offset
                    local by = MenuBtn.Position.Y.Offset
                    -- Tự động canh trái/phải tuỳ vị trí nút
                    local screenW = Camera.ViewportSize.X
                    if bx + 280 > screenW then
                        MenuPanel.Position = UDim2.new(0, bx - 230, 0, by)
                    else
                        MenuPanel.Position = UDim2.new(0, bx + 65, 0, by)
                    end
                end
            end
            dragging = false
        end
    end)
end

