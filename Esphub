local function GetESP(pl)
    if Cache[pl] then return Cache[pl] end
    local chr=pl.Character
    local hrp=chr and chr:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    pcall(function()
        local old=hrp:FindFirstChild("ESP_BB")
        if old then old:Destroy() end
    end)

    local bb=N("BillboardGui",{
        Name="ESP_BB",
        Size=UDim2.new(0,95,0,120),
        StudsOffset=Vector3.new(0,3.2,0),
        AlwaysOnTop=true,
        Active=false,
        ResetOnSpawn=false,
        Enabled=true,
    },hrp)

    local nameL=N("TextLabel",{
        Size=UDim2.new(1,0,0,20),
        Position=UDim2.new(0,0,0,0),
        BackgroundTransparency=1,
        TextColor3=CFG.NameColor,
        Font=Enum.Font.GothamBold,
        TextSize=15,
        Text=pl.DisplayName,
        TextStrokeTransparency=0.4,
        TextStrokeColor3=Color3.new(0,0,0),
    },bb)

    local distL=N("TextLabel",{
        Size=UDim2.new(1,0,0,18),
        Position=UDim2.new(0,0,1,-18),
        BackgroundTransparency=1,
        TextColor3=CFG.DistColor,
        Font=Enum.Font.GothamBold,
        TextSize=13,Text="",
        TextStrokeTransparency=0.4,
        TextStrokeColor3=Color3.new(0,0,0),
    },bb)

    local boxC=N("Frame",{
        Size=UDim2.new(1,0,1,-22),
        Position=UDim2.new(0,0,0,21),
        BackgroundTransparency=1,
        BorderSizePixel=0,
    },bb)
    N("UIStroke",{
        Color=CFG.BoxColor,Thickness=2,
        ApplyStrokeMode=Enum.ApplyStrokeMode.Border,
    },boxC)

    Cache[pl]={bb=bb,nameL=nameL,distL=distL,boxC=boxC}
    return Cache[pl]
end

local function RemESP(pl)
    if not Cache[pl] then return end
    pcall(function() Cache[pl].bb:Destroy() end)
    Cache[pl]=nil
end

