--> BƯỚC 15: Update loop
RunService.RenderStepped:Connect(function()
    local cnt=0
    for _,pl in ipairs(Players:GetPlayers()) do
        if pl==LocalPlayer then continue end
        if not STATE.Team and pl.Team==LocalPlayer.Team then
            RemESP(pl) continue
        end
        local chr=pl.Character
        local hrp=chr and chr:FindFirstChild("HumanoidRootPart")
        local hum=chr and chr:FindFirstChildOfClass("Humanoid")
        if not chr or not hrp or not hum or hum.Health<=0 then
            RemESP(pl) continue
        end
        local lhrp=LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local dist=lhrp and (hrp.Position-lhrp.Position).Magnitude or 0
        if dist>CFG.MaxDist then RemESP(pl) continue end
        if not STATE.ESP then
            if Cache[pl] then pcall(function() Cache[pl].bb.Enabled=false end) end
            continue
        end
        cnt+=1
        local d=GetESP(pl)
        if not d then continue end
        pcall(function()
            d.bb.Enabled=true
            d.nameL.Visible=STATE.Name
            d.nameL.Text=pl.DisplayName
            d.distL.Visible=STATE.Dist
            d.distL.Text=string.format("[%.0f m]",dist)
            d.boxC.Visible=STATE.Box
        end)
    end
    CLabel.Text=string.format("👁  Kẻ Địch: %d",cnt)
end)

