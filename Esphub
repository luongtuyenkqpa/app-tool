local function CreateToggle(yPos, labelText, defaultState, callback)
    local row = Make("Frame", {
        Size = UDim2.new(1, -20, 0, 42),
        Position = UDim2.new(0, 10, 0, yPos),
        BackgroundColor3 = Color3.fromRGB(18, 18, 42),
        BorderSizePixel = 0,
        ZIndex = 201,
    }, MenuPanel)
    AddCorner(row, 9)

    Make("TextLabel", {
        Size = UDim2.new(0.6, 0, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1,
        TextColor3 = Color3.fromRGB(230, 230, 230),
        Font = Enum.Font.Gotham,
        TextSize = 13,
        Text = labelText,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 202,
    }, row)

    local state = defaultState
    local btn = Make("TextButton", {
        Size = UDim2.new(0, 60, 0, 30),
        Position = UDim2.new(1, -68, 0.5, -15),
        BackgroundColor3 = state and Color3.fromRGB(45, 200, 75) or Color3.fromRGB(130, 35, 35),
        TextColor3 = Color3.fromRGB(255, 255, 255),
        Font = Enum.Font.GothamBold,
        Text = state and "BẬT" or "TẮT",
        TextSize = 13,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        ZIndex = 202,
    }, row)
    AddCorner(btn, 15)

    -- Hỗ trợ cả tap và click
    local function onToggle()
        state = not state
        btn.Text = state and "BẬT" or "TẮT"
        TweenService:Create(btn, TweenInfo.new(0.12), {
            BackgroundColor3 = state
                and Color3.fromRGB(45, 200, 75)
                or  Color3.fromRGB(130, 35, 35)
        }):Play()
        callback(state)
    end

    btn.MouseButton1Click:Connect(onToggle)
    btn.TouchTap:Connect(onToggle)

    return btn
end

