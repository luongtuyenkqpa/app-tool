local function CleanupOld()
    for _, name in ipairs({"ESP_V3_GUI","ESP_MENU_GUI","ESP_V4_GUI"}) do
        pcall(function() game:GetService("CoreGui")[name]:Destroy() end)
        pcall(function() LocalPlayer.PlayerGui[name]:Destroy() end)
    end
    -- Xóa BillboardGui cũ
    for _, pl in ipairs(Players:GetPlayers()) do
        pcall(function()
            local chr = pl.Character
            if chr then
                local hrp = chr:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local old = hrp:FindFirstChild("ESP_BB")
                    if old then old:Destroy() end
                end
            end
        end)
    end
end
