    lbl.Position         = UDim2.fromOffset(22, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text             = label
    lbl.TextColor3       = Color3.fromRGB(190, 190, 205)
    lbl.TextSize         = 12
    lbl.Font             = Enum.Font.Gotham
    lbl.TextXAlignment   = Enum.TextXAlignment.Left

    local function refresh()
        if optTable[key] then
            check.Text             = "✓"
            box.BackgroundColor3   = Color3.fromRGB(200, 50, 50)
            boxStroke.Color        = Color3.fromRGB(255, 80, 80)
        else
            check.Text             = ""
            box.BackgroundColor3   = Color3.fromRGB(40, 40, 60)
            boxStroke.Color        = Color3.fromRGB(100, 100, 140)
        end
    end

    local btn = Instance.new("TextButton", row)
    btn.Size             = UDim2.fromScale(1, 1)
    btn.BackgroundTransparency = 1
    btn.Text             = ""
    btn.Activated:Connect(function()
        optTable[key] = not optTable[key]
        refresh()
    end)

    refresh()
    return btn, refresh
end

