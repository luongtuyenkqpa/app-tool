local wallCache    = {}
local WALL_INTERVAL = 0.15

local function isPlayerVisible(targetPlayer)
    local now = tick()
    local cache = wallCache[targetPlayer]
    if cache and (now - cache.lastCheck) < WALL_INTERVAL then
        return cache.visible
    end

    local myChar = LocalPlayer.Character
    if not myChar then
        wallCache[targetPlayer] = {visible = false, lastCheck = now}
        return false
    end
    local myHead = myChar:FindFirstChild("Head") or myChar:FindFirstChild("HumanoidRootPart")
    if not myHead then
        wallCache[targetPlayer] = {visible = false, lastCheck = now}
        return false
    end

    local targetChar = targetPlayer.Character
    if not targetChar then
        wallCache[targetPlayer] = {visible = false, lastCheck = now}
        return false
    end
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    if not targetRoot then
        wallCache[targetPlayer] = {visible = false, lastCheck = now}
        return false
    end

    local origin    = myHead.Position
    local direction = (targetRoot.Position - origin)
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {myChar, targetChar}
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local result = workspace:Raycast(origin, direction, rayParams)
    local vis = (result == nil)

    wallCache[targetPlayer] = {visible = vis, lastCheck = now}
    return vis
end

Players.PlayerRemoving:Connect(function(p)
    wallCache[p] = nil
end)

