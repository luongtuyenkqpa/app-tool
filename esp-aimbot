local function makeLine(color)
    local f = Instance.new("Frame", gui)
    f.BackgroundColor3 = color or Color3.new(1,1,1)
    f.BorderSizePixel  = 0
    f.AnchorPoint      = Vector2.new(0.5, 0.5)
    f.Visible          = false
    return f
end

local function drawLine(f, from2D, to2D, thick)
    local d = to2D - from2D
    local len = d.Magnitude
    if len < 1 then f.Visible = false; return end
    f.Size     = UDim2.fromOffset(len, thick or 1.5)
    f.Position = UDim2.fromOffset((from2D.X+to2D.X)/2, (from2D.Y+to2D.Y)/2)
    f.Rotation = math.deg(math.atan2(d.Y, d.X))
    f.Visible  = true
end

local function removeESP(player)
    local obj = espObjects[player]
    if not obj then return end
    if obj.hl      then obj.hl:Destroy() end
    if obj.bbg     then obj.bbg:Destroy() end
    if obj.espLine then obj.espLine:Destroy() end
    for _, b in ipairs(obj.bones or {}) do b:Destroy() end
    espObjects[player] = nil
end

local function addESP(player)
    removeESP(player)
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local col = CONFIG.ESP_COLOR_ENEMY

    local hl = Instance.new("Highlight")
    hl.Name                = "ESP_HL"
    hl.Adornee             = char
    hl.FillColor           = col
    hl.OutlineColor        = col
    hl.FillTransparency    = CONFIG.ESP_FILL_TRANSPARENCY
    hl.OutlineTransparency = 0
    hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent              = char

    local bbg = Instance.new("BillboardGui", gui)
    bbg.Adornee     = root
    bbg.Size        = UDim2.fromOffset(190, 50)
    bbg.StudsOffset = Vector3.new(0, 3.2, 0)
    bbg.AlwaysOnTop = true

    local nameLbl = Instance.new("TextLabel", bbg)
    nameLbl.Size                   = UDim2.new(1, 0, 0.54, 0)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Text                   = player.DisplayName ~= "" and player.DisplayName or player.Name
    nameLbl.TextColor3             = col
    nameLbl.TextStrokeTransparency = 0.4
    nameLbl.TextStrokeColor3       = Color3.new(0,0,0)
    nameLbl.TextSize               = CONFIG.NAME_TAG_SIZE + 2
    nameLbl.Font                   = Enum.Font.GothamBold

    local distLbl = Instance.new("TextLabel", bbg)
    distLbl.Size                   = UDim2.new(1, 0, 0.46, 0)
    distLbl.Position               = UDim2.new(0, 0, 0.54, 0)
    distLbl.BackgroundTransparency = 1
    distLbl.Text                   = ""
    distLbl.TextColor3             = Color3.fromRGB(255, 240, 160)
    distLbl.TextStrokeTransparency = 0.4
    distLbl.TextStrokeColor3       = Color3.new(0,0,0)
    distLbl.TextSize               = CONFIG.NAME_TAG_SIZE
    distLbl.Font                   = Enum.Font.Gotham

    local espLine = makeLine(col)

    local bones = {}
    for _ = 1, #BONES do
        table.insert(bones, makeLine(Color3.fromRGB(255, 255, 255)))
    end

    espObjects[player] = {
        hl      = hl,
        bbg     = bbg,
        nameLbl = nameLbl,
        distLbl = distLbl,
        espLine = espLine,
        bones   = bones,
        char    = char,
    }
end

--==================================================
-- UPDATE PER FRAME
--==================================================

local vp = Camera.ViewportSize

RunService.RenderStepped:Connect(function()
    vp = Camera.ViewportSize
    local screenCenter = Vector2.new(vp.X / 2, vp.Y - 40)
    espCount = 0

    fovFrame.Visible = AIM_ENABLED and CONFIG.AIM_SHOW_FOV_CIRCLE

    local myRole = getMyRole()
    if myRole == "Seeker" then
        roleLbl.Text      = "🔎 Người Đi Tìm (S)"
        roleLbl.TextColor3 = Color3.fromRGB(255, 100, 100)
    elseif myRole == "Hider" then
        roleLbl.Text      = "🫣 Người Đi Trốn (H)"
        roleLbl.TextColor3 = Color3.fromRGB(100, 200, 255)
    else
        roleLbl.Text      = "❓ Đang xác định..."
        roleLbl.TextColor3 = Color3.fromRGB(180, 180, 100)
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end

        local obj = espObjects[player]

        if obj and obj.char ~= player.Character then
            removeESP(player)
            obj = nil
        end

        if not ESP_ENABLED or not isEnemy(player) then
            if obj then
                if obj.hl      then obj.hl.Enabled = false end
                if obj.bbg     then obj.bbg.Enabled = false end
                if obj.espLine then obj.espLine.Visible = false end
                for _, b in ipairs(obj.bones or {}) do b.Visible = false end
            end
            continue
        end

        local char = player.Character
        if not char then continue end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then continue end

        local dist = getDistanceTo(player)
        if dist > CONFIG.ESP_MAX_DISTANCE then
            if obj then
                if obj.hl      then obj.hl.Enabled  = false end
                if obj.bbg     then obj.bbg.Enabled  = false end
                if obj.espLine then obj.espLine.Visible = false end
                for _, b in ipairs(obj.bones or {}) do b.Visible = false end
            end
            continue
        end

        espCount = espCount + 1

        if not obj then
            addESP(player)
            obj = espObjects[player]
        end
        if not obj then continue end

        -- Đọc trực tiếp từ bảng OPT (thủ công)
        local showBox  = OPT.box
        local showName = OPT.name
        local showDist = OPT.dist
        local showSkel = OPT.skeleton
        local showLine = OPT.lines

        if obj.hl then obj.hl.Enabled = showBox end

        if obj.bbg then
            obj.bbg.Enabled = showName or showDist
            if obj.nameLbl then obj.nameLbl.Visible = showName end
            if obj.distLbl then
                obj.distLbl.Visible = showDist
                if showDist then
                    obj.distLbl.Text = string.format("📏 %.0f m", dist)
                end
            end
        end

        if obj.espLine then
            if showLine then
                local rp2d, on = worldToVP(root.Position)
                if on then
                    drawLine(obj.espLine, screenCenter, rp2d, 1.5)
                else
                    obj.espLine.Visible = false
                end
            else
                obj.espLine.Visible = false
            end
        end

        for i, bonePair in ipairs(BONES) do
            local bLine = obj.bones[i]
            if not bLine then continue end
            if showSkel then
                local p1 = char:FindFirstChild(bonePair[1])
                local p2 = char:FindFirstChild(bonePair[2])
                if p1 and p2 then
                    local a2d, on1 = worldToVP(p1.Position)
                    local b2d, on2 = worldToVP(p2.Position)
                    if on1 or on2 then
                        drawLine(bLine, a2d, b2d, 1.2)
                    else
                        bLine.Visible = false
                    end
                else
                    bLine.Visible = false
                end
            else
                bLine.Visible = false
            end
        end
    end

    countLbl.Text = "👁  ESP: " .. espCount .. " người"

    if not AIM_ENABLED then return end

    local center  = Vector2.new(vp.X / 2, vp.Y / 2)
    local nearPart = nil
    local nearDist = CONFIG.AIM_FOV

    for _, player in ipairs(Players:GetPlayers()) do
        if not isEnemy(player) then continue end
        local char = player.Character
        if not char then continue end
        local part = char:FindFirstChild(CONFIG.AIM_TARGET_PART)
        if not part then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local sp, on = worldToVP(part.Position)
        if not on then continue end
        local d = (sp - center).Magnitude
        if d < nearDist then
            nearDist = d
            nearPart = part
        end
    end

    if nearPart then
        local cur = Camera.CFrame
        local tCF = CFrame.lookAt(cur.Position, nearPart.Position)
        Camera.CFrame = cur:Lerp(tCF, CONFIG.AIM_SMOOTH)
    end
end)

