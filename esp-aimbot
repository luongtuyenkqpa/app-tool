local lastCountTick = 0
local espVisible    = 0

RunService.Heartbeat:Connect(function()
    -- Cập nhật đếm địch mỗi 1 giây
    local now = tick()
    if now - lastCountTick >= 1.0 then
        lastCountTick = now
        local vis, enemy = 0, 0
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                if isEnemy(p) then enemy = enemy + 1 end
            end
        end
        espVisible = vis
        enemyCountLbl.Text = string.format("⚔️  Địch: %d người", enemy)
    end
end)

RunService.RenderStepped:Connect(function()
    local vp     = Camera.ViewportSize
    local center = Vector2.new(vp.X/2, vp.Y/2)
    local visCount = 0

    -- ESP loop
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end

        local obj = espObjects[player]

        -- Char thay đổi → rebuild
        if obj and player.Character and obj.char ~= player.Character then
            removeESP(player)
            obj = nil
        end

        if not ESP_ON then
            if obj then
                if obj.billboard then obj.billboard.Enabled = false end
                if obj.lineFrame  then obj.lineFrame.Visible  = false end
            end
            continue
        end

        local char = player.Character
        if not char then continue end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then continue end

        local dist = getDist(player)
        if dist > CFG.ESP_MAX_DIST then
            if obj then
                if obj.billboard then obj.billboard.Enabled = false end
                if obj.lineFrame  then obj.lineFrame.Visible  = false end
            end
            continue
        end

        -- Add ESP nếu chưa có
        if not obj then
            addESP(player)
            obj = espObjects[player]
            if not obj then continue end
        end

        -- Màu theo team
        local enemy    = isEnemy(player)
        local baseCol  = enemy and CFG.ESP_ENEMY_COLOR or CFG.ESP_ALLY_COLOR
        local vis      = OPT.wallchk and isVisible(player) or true
        local espCol   = OPT.wallchk and (vis and CFG.ESP_VISIBLE_COLOR or baseCol) or baseCol

        if vis then visCount = visCount + 1 end

        -- Update billboard
        if obj.billboard then
            obj.billboard.Enabled = true
            -- Tên
            if obj.nameLbl then
                obj.nameLbl.Visible    = OPT.name
                obj.nameLbl.TextColor3 = espCol
                local teamTag = (getTeam(player) == "Star") and " [★]" or (getTeam(player) == "Iron") and " [⚙]" or " [?]"
                obj.nameLbl.Text = (player.DisplayName ~= "" and player.DisplayName or player.Name) .. teamTag
            end

            -- Máu
            if obj.hpBar then
                obj.hpBar.Parent.Visible = OPT.health
                local hp, maxhp = getHealth(player)
                local pct = maxhp > 0 and hp/maxhp or 0
                obj.hpBar.Size = UDim2.fromScale(pct, 1)
                obj.hpBar.BackgroundColor3 = Color3.fromRGB(
                    math.floor((1-pct)*255),
                    math.floor(pct*210),
                    40
                )
            end

            -- Khoảng cách
            if obj.distLbl then
                obj.distLbl.Visible = OPT.dist
                obj.distLbl.Text    = string.format("📏 %.0f m", dist)
            end

            -- Tường status
            if obj.wallLbl then
                obj.wallLbl.Visible = OPT.wallchk
                if OPT.wallchk then
                    if vis then
                        obj.wallLbl.Text       = "✅ Thấy thẳng"
                        obj.wallLbl.TextColor3 = Color3.fromRGB(60, 230, 100)
                    else
                        obj.wallLbl.Text       = "🧱 Qua tường"
                        obj.wallLbl.TextColor3 = Color3.fromRGB(255, 80, 80)
                    end
                end
            end
        end

        -- Line từ giữa màn hình đến chân nhân vật
        if obj.lineFrame then
            if OPT.lines then
                local feet = root.Position - Vector3.new(0, 3, 0)
                local sp, onScreen = worldToVP(feet)
                if onScreen then
                    local dx   = sp.X - center.X
                    local dy   = sp.Y - center.Y
                    local len  = math.sqrt(dx*dx + dy*dy)
                    local ang  = math.atan2(dy, dx)
                    obj.lineFrame.Visible         = true
                    obj.lineFrame.Size            = UDim2.fromOffset(math.max(1, len), 1)
                    obj.lineFrame.Position        = UDim2.fromOffset(center.X, center.Y)
                    obj.lineFrame.Rotation        = math.deg(ang)
                    obj.lineFrame.BackgroundColor3 = espCol
                else
                    obj.lineFrame.Visible = false
                end
            else
                obj.lineFrame.Visible = false
            end
        end
    end

    -- Cập nhật label thấy
    visCountLbl.Text = string.format("👁  Thấy: %d người", visCount)

    -- FOV Circle
    do
        local fovPx = getFOVpx()
        if AIM_ON and AOPT.fov then
            fovCircle.Visible  = true
            fovCircle.Size     = UDim2.fromOffset(fovPx*2, fovPx*2)
            fovCircle.Position = UDim2.fromOffset(center.X, center.Y)
            fovStroke.Color    = CFG.AIM_FOV_COLOR
        else
            fovCircle.Visible = false
        end
    end

    -- AIMBOT
    if not AIM_ON then return end

    local shouldAim = false
    if AOPT.always   then shouldAim = true
    elseif AOPT.fireOnly then shouldAim = isFiring
    elseif AOPT.manual   then shouldAim = true
    end
    if not shouldAim then return end

    local fovPx    = getFOVpx()
    local bestPart = nil
    local bestDist = fovPx

    for _, player in ipairs(Players:GetPlayers()) do
        if not isEnemy(player) then continue end
        local char = player.Character
        if not char then continue end
        local part = char:FindFirstChild(CFG.AIM_TARGET)
                  or char:FindFirstChild("HumanoidRootPart")
        if not part then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end

        -- Wall check for aimbot
        if AOPT.wallchk and not isVisible(player) then continue end

        local sp, onScreen = worldToVP(part.Position)
        if not onScreen then continue end
        local d = (sp - center).Magnitude
        if d < bestDist then
            bestDist = d
            bestPart = part
        end
    end

    if bestPart then
        local cur  = Camera.CFrame
        local tgt  = CFrame.lookAt(cur.Position, bestPart.Position)
        Camera.CFrame = cur:Lerp(tgt, CFG.AIM_SMOOTH)
    end
end)

