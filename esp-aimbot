local function setFOVPct(pct)
    pct = math.clamp(math.floor(pct), 1, 100)
    CONFIG.AIM_FOV_PCT = pct
    local t = pct / 100
    sliderFill.Size      = UDim2.new(t, 0, 1, 0)
    sliderThumb.Position = UDim2.new(t, 0, 0.5, 0)
    fovLabel.Text = string.format("FOV: %d%%", pct)
