-- BUTTON EVENTS (ESP toggle: bật → addESP, tắt → removeESP)
--==================================================

-- espBtnRef / aimBtnRef được lưu khi makeToggle tạo
-- Logic addESP/removeESP thêm vào espBtnRef.Activated
espBtnRef.Activated:Connect(function()
    -- ESP_ENABLED đã được cập nhật bởi closure trong makeToggle
    -- Dùng task.defer để đảm bảo giá trị đã ghi xong
    task.defer(function()
        if ESP_ENABLED then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and isEnemy(p) then addESP(p) end
            end
        else
            for _, p in ipairs(Players:GetPlayers()) do removeESP(p) end
            espCount = 0
            countLbl.Text = "👁  ESP: 0 người"
        end
    end)
end)

