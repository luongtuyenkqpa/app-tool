local lastCountTick = 0
local COUNT_INTERVAL = 1.0  -- cập nhật HUD mỗi 1 giây

local function updateServerCount()
    local h, s = 0, 0
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local r = getRole(p)
        if r == "Hider"  then h = h + 1
        elseif r == "Seeker" then s = s + 1
        end
    end
    totalH = h
    totalS = s

    -- Cập nhật HUD ngay
    hudHNum.Text = tostring(totalH)
    hudSNum.Text = tostring(totalS)

    -- Đổi màu khi = 0
    hudHNum.TextColor3 = totalH > 0 and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(130, 150, 180)
    hudSNum.TextColor3 = totalS > 0 and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 130, 130)
end

--==================================================
-- RENDER LOOP CHÍNH - DÙNG Heartbeat thay vì RenderStepped
-- (Heartbeat nhẹ hơn, không block render pipeline)
--==================================================

RunService.Heartbeat:Connect(function()
    local now = tick()
    vp = Camera.ViewportSize

    -- Đếm server count mỗi 1 giây
    if now - lastCountTick >= COUNT_INTERVAL then
        lastCountTick = now
        updateServerCount()
        hudFrame.Visible = ESP_ENABLED
        screenBadgeFrame.Visible = ESP_ENABLED  -- badge trên màn hình chỉ hiện khi ESP bật
    end
end)

local vp = Camera.ViewportSize

RunService.RenderStepped:Connect(function()
    vp = Camera.ViewportSize
    local lineOrigin = Vector2.new(vp.X / 2, 0)

    espCountVisible = 0

    fovFrame.Visible = AIM_ENABLED and OPT.fov

    -- Role label
    local myRole = getMyRole()
    if myRole == "Seeker" then
        roleLbl.Text       = "🔎 Người Tìm (S)"
        roleLbl.TextColor3 = Color3.fromRGB(255, 100, 100)
    elseif myRole == "Hider" then
        roleLbl.Text       = "🫣 Người Trốn (H)"
        roleLbl.TextColor3 = Color3.fromRGB(100, 200, 255)
    else
        roleLbl.Text       = "❓ Xác định..."
        roleLbl.TextColor3 = Color3.fromRGB(180, 180, 100)
    end

    if myRole ~= lastMyRole then
        lastMyRole = myRole
        if ESP_ENABLED then rebuildAllESP() end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end

        local obj = espObjects[player]

        if obj and obj.char ~= player.Character then
            removeESP(player)
            obj = nil
        end

        if not ESP_ENABLED then
            if obj then
                if obj.hl      then obj.hl.Enabled = false end
                if obj.bbg     then obj.bbg.Enabled = false end
                if obj.espLine then obj.espLine.Visible = false end
                for _, b in ipairs(obj.bones or {}) do b.Visible = false end
            end
            continue
        end

        local char = player.Character
        if not char then continue end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then continue end

        local dist = getDistanceTo(player)
        if dist > CONFIG.ESP_MAX_DISTANCE then
            if obj then
                if obj.hl      then obj.hl.Enabled  = false end
                if obj.bbg     then obj.bbg.Enabled  = false end
                if obj.espLine then obj.espLine.Visible = false end
                for _, b in ipairs(obj.bones or {}) do b.Visible = false end
            end
            continue
        end

        espCountVisible = espCountVisible + 1

        if not obj then
            addESP(player)
            obj = espObjects[player]
        end
        if not obj then continue end

        -- Màu nền theo role (cập nhật realtime nếu role vừa detect được)
        local role = getRole(player)
        local roleColor
        if role == "Hider" then
            roleColor = CONFIG.ESP_COLOR_ALLY
        elseif role == "Seeker" then
            roleColor = CONFIG.ESP_COLOR_ENEMY
        else
            roleColor = Color3.fromRGB(255, 220, 50)  -- vàng = chưa xác định
        end

        -- Wall check: khi ngoài tường dùng màu xanh lá, khi trong tường dùng roleColor
        local visible = OPT.wallcheck and isPlayerVisible(player) or true
        local espColor
        if OPT.wallcheck then
            espColor = visible and CONFIG.ESP_COLOR_VISIBLE or roleColor
        else
            espColor = roleColor
        end

        if obj.hl then
            obj.hl.FillColor    = espColor
            obj.hl.OutlineColor = espColor
        end
        if obj.nameLbl then
            -- Tên hiển thị kèm badge H/S
            local roleTag = role == "Hider" and " [H]" or (role == "Seeker" and " [S]" or " [?]")
            obj.nameLbl.Text       = (player.DisplayName ~= "" and player.DisplayName or player.Name) .. roleTag
            obj.nameLbl.TextColor3 = espColor
        end
        if obj.espLine then
            obj.espLine.BackgroundColor3 = espColor
        end

        if obj.wallLbl then
            if OPT.wallcheck then
                obj.wallLbl.Text       = visible and "✅ Ngoài tường" or "🧱 Trong tường"
                obj.wallLbl.TextColor3 = visible and Color3.fromRGB(80, 220, 100) or Color3.fromRGB(255, 60, 60)
                obj.wallLbl.Visible    = true
            else
                obj.wallLbl.Visible = false
            end
        end

        local showBox  = OPT.box
        local showName = OPT.name
        local showDist = OPT.dist
        local showSkel = OPT.skeleton
        local showLine = OPT.lines

        if obj.hl then obj.hl.Enabled = showBox end

        if obj.bbg then
            obj.bbg.Enabled = showName or showDist or OPT.wallcheck
            if obj.nameLbl then obj.nameLbl.Visible = showName end
            if obj.distLbl then
                obj.distLbl.Visible = showDist
                if showDist then
                    obj.distLbl.Text = string.format("📏 %.0f m", dist)
                end
            end
        end

        if obj.espLine then
            if showLine then
                local rp2d, on = worldToVP(root.Position)
                if on then
                    drawLine(obj.espLine, lineOrigin, rp2d, 1.5)
                else
                    obj.espLine.Visible = false
                end
            else
                obj.espLine.Visible = false
            end
        end

        for i, bonePair in ipairs(BONES) do
            local bLine = obj.bones[i]
            if not bLine then continue end
            if showSkel then
                local p1 = char:FindFirstChild(bonePair[1])
                local p2 = char:FindFirstChild(bonePair[2])
                if p1 and p2 then
                    local a2d, on1 = worldToVP(p1.Position)
                    local b2d, on2 = worldToVP(p2.Position)
                    if on1 or on2 then
                        drawLine(bLine, a2d, b2d, 1.2)
                    else
                        bLine.Visible = false
                    end
                else
                    bLine.Visible = false
                end
            else
                bLine.Visible = false
            end
        end
    end

    -- Cập nhật badge màn hình (v8: hiện dưới chữ "Tìm những kẻ trốn")
    if espCountVisible > 0 then
        countLbl.Text                        = string.format("👁  Thấy: %d người", espCountVisible)
        screenBadgeFrame.BackgroundColor3    = Color3.fromRGB(10, 40, 90)
        scBadgeStroke.Color                  = Color3.fromRGB(60, 180, 255)
    else
        countLbl.Text                        = "👁  Thấy: 0 người"
        screenBadgeFrame.BackgroundColor3    = Color3.fromRGB(8, 20, 50)
        scBadgeStroke.Color                  = Color3.fromRGB(40, 100, 180)
    end

    -- AIMBOT v8 - 3 chế độ thủ công
    if not AIM_ENABLED then return end

    -- Xác định có nên aimbot lần này không:
    -- 1. Luôn aimbot → aimbot bất kể
    -- 2. Bắn khi aim → chỉ aimbot khi isFiring = true
    -- 3. Aimbot thủ công → chỉ aimbot khi AIM_OPT.manual = true
    -- Nếu không có checkbox nào được tick → không aimbot
    local shouldAim = false
    if AIM_OPT.always then
        shouldAim = true
    elseif AIM_OPT.fireOnly then
        shouldAim = isFiring
    elseif AIM_OPT.manual then
        shouldAim = true
    end

    if not shouldAim then return end

    local center   = Vector2.new(vp.X / 2, vp.Y / 2)
    local fovPx    = getFOVpx()
    local nearPart = nil
    local nearDist = fovPx

    for _, player in ipairs(Players:GetPlayers()) do
        if not isEnemy(player) then continue end
        local char = player.Character
        if not char then continue end
        local part = char:FindFirstChild(CONFIG.AIM_TARGET_PART)
        if not part then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local sp, on = worldToVP(part.Position)
        if not on then continue end
        local d = (sp - center).Magnitude
        if d < nearDist then
            nearDist = d
            nearPart = part
        end
    end

    if nearPart then
        local cur = Camera.CFrame
        local tCF = CFrame.lookAt(cur.Position, nearPart.Position)
        Camera.CFrame = cur:Lerp(tCF, CONFIG.AIM_SMOOTH)
    end
end)

