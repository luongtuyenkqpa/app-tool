    if not _mtbDragging then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement
    and input.UserInputType ~= Enum.UserInputType.Touch then return end
    local d = input.Position - _mtbDragStart
    if d.Magnitude > 4 then _mtbMoved = true end
    menuToggleBtn.Position = UDim2.new(
        _mtbStartPos.X.Scale, _mtbStartPos.X.Offset + d.X,
        _mtbStartPos.Y.Scale, _mtbStartPos.Y.Offset + d.Y
    )
end)

