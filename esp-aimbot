    ESP    = Color3.fromRGB(255, 65, 65),
    AIMBOT = Color3.fromRGB(255, 140, 30),
    INFO   = Color3.fromRGB(100, 180, 255),
}

local function switchTab(name)
    activeTab = name
    for _, n in ipairs(TABS) do
        local btn = tabBtns[n]
        local pan = tabPanels[n]
        if n == name then
            btn.BackgroundColor3 = TAB_COLORS[n]
            btn.TextColor3       = Color3.fromRGB(255, 255, 255)
            pan.Visible          = true
        else
            btn.BackgroundColor3 = Color3.fromRGB(20, 20, 38)
            btn.TextColor3       = Color3.fromRGB(140, 140, 160)
            pan.Visible          = false
        end
    end
end

