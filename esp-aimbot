-- v14: throttle timers để giảm lag
local _lastESPUpdate  = 0
local _lastBoneUpdate = 0
local _espDirty       = true   -- flag: cần update esp ngay lần tới

RunService.Heartbeat:Connect(function()
    local now = tick()
    vp = Camera.ViewportSize

    if now - lastCountTick >= COUNT_INTERVAL then
        lastCountTick = now
        updateServerCount()
        screenBadgeFrame.Visible = ESP_ENABLED
        _espDirty = true  -- role có thể đổi → cần update ESP
    end
end)

RunService.RenderStepped:Connect(function()
    local now = tick()
    vp = Camera.ViewportSize

    -- v14: FOV circle chỉ update khi cần (nhẹ)
    fovFrame.Visible = AIM_ENABLED and OPT.fov

    -- Role label (nhẹ, giữ mỗi frame)
    local myRole = getMyRole()
    if myRole == "Seeker" then
        roleLbl.Text       = "🔴 Bạn đang: Người Tìm (S)"
        roleLbl.TextColor3 = Color3.fromRGB(255, 100, 100)
    elseif myRole == "Hider" then
        roleLbl.Text       = "🔵 Bạn đang: Người Trốn (H)"
        roleLbl.TextColor3 = Color3.fromRGB(100, 180, 255)
    else
        roleLbl.Text       = "❓ Xác định role..."
        roleLbl.TextColor3 = Color3.fromRGB(255, 220, 80)
    end

    if not ESP_ENABLED then
        -- v14: chỉ ẩn khi mới tắt (dùng dirty flag)
        if _espDirty then
            _espDirty = false
            for _, obj in pairs(espObjects) do
                if obj.bbg then obj.bbg.Enabled = false end
                if obj.hl  then obj.hl.Enabled  = false end
                if obj.espLine then obj.espLine.Visible = false end
                for _, b in ipairs(obj.bones or {}) do b.Visible = false end
            end
        end
        -- Vẫn chạy aimbot khi ESP tắt
        goto aimbot_section
    end

    -- v14: Throttle ESP update (50ms) để giảm lag mobile
    if now - _lastESPUpdate < CONFIG.RENDER_ESP_INTERVAL and not _espDirty then
        goto aimbot_section
    end
    _lastESPUpdate = now
    _espDirty = false

    do  -- scope ESP loop
    local lineOrigin = Vector2.new(vp.X / 2, 0)
    espCountVisible = 0

    for player, obj in pairs(espObjects) do
        local char = obj.char
        if not char or not char.Parent then
            removeESP(player)
            if ESP_ENABLED then
                task.defer(function() addESP(player) end)
            end
            continue
        end

        local root = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        local hum  = char:FindFirstChildOfClass("Humanoid")
        if not root or not hum then continue end
        if hum.Health <= 0 then
            if obj.hl      then obj.hl.Enabled     = false end
            if obj.bbg     then obj.bbg.Enabled     = false end
            if obj.espLine then obj.espLine.Visible = false end
            for _, b in ipairs(obj.bones or {}) do b.Visible = false end
            continue
        end

        -- v12: Lọc đồng đội khỏi ESP real-time
        local myRole    = getMyRole()
        local theirRole = getRole(player)
        if myRole and theirRole and myRole == theirRole then
            -- Đồng đội → ẩn hoàn toàn
            if obj.bbg  then obj.bbg.Enabled  = false end
            if obj.hl   then obj.hl.Enabled   = false end
            if obj.espLine then obj.espLine.Visible = false end
            for _, b in ipairs(obj.bones or {}) do b.Visible = false end
            continue
        end

        -- Màu cơ bản theo phe
        local role = theirRole
        local col  = getEnemyESPColor(player)

        -- Cập nhật roleTag
        if obj.roleTag then
            obj.roleTag.Text = role == "Hider" and "H" or (role == "Seeker" and "S" or "?")
            obj.roleTag.BackgroundColor3 = role == "Seeker"
                and Color3.fromRGB(180, 40, 30)
                or (role == "Hider" and Color3.fromRGB(160, 130, 0) or Color3.fromRGB(30, 60, 120))
        end
        if obj.nameLbl then obj.nameLbl.TextColor3 = col end
        if obj.espLine then obj.espLine.BackgroundColor3 = col end

        local dist = getDistanceTo(player)
        if dist > CONFIG.ESP_MAX_DISTANCE then
            if obj.bbg     then obj.bbg.Enabled     = false end
            if obj.espLine then obj.espLine.Visible  = false end
            if obj.hl      then obj.hl.Enabled       = false end
            for _, b in ipairs(obj.bones or {}) do b.Visible = false end
            continue
        end

        -- v12 FIX CHECK TƯỜNG: Kiểm tra thấy hay sau tường
        local isVis = isPlayerVisible(player)  -- luôn tính, dùng cho cả màu lẫn badge

        local showSkel = OPT.skeleton
        local showBox  = OPT.box
        local showName = OPT.name
        local showDist = OPT.dist
        local showLine = OPT.lines

        -- v12 FIX: Màu Highlight theo check tường
        -- Nếu OPT.wallcheck bật:
        --   isVis = true  → màu XANH (thấy được)
        --   isVis = false → màu ĐỎ (sau tường)
        -- Nếu OPT.wallcheck tắt: dùng màu phe bình thường
        local espCol
        if OPT.wallcheck then
            espCol = isVis and CONFIG.ESP_COLOR_VISIBLE or CONFIG.ESP_COLOR_THROUGH_WALL
        else
            espCol = col
        end

        if showBox and obj.hl then
            obj.hl.FillColor    = espCol
            obj.hl.OutlineColor = espCol
            obj.hl.Enabled      = true
        elseif obj.hl then
            obj.hl.Enabled = false
        end

        if obj.bbg then obj.bbg.Enabled = true end

        espCountVisible = espCountVisible + 1

        if showName then
            obj.nameLbl.Visible = true
        else
            obj.nameLbl.Visible = false
        end

        if showDist then
            obj.distLbl.Text    = string.format("%.0f m", dist)
            obj.distLbl.Visible = true
        else
            obj.distLbl.Visible = false
        end

        -- v12: Wall label luôn hiện khi wallcheck bật
        if OPT.wallcheck then
            obj.wallLbl.Text       = isVis and "● Thấy" or "● Tường"
            obj.wallLbl.TextColor3 = isVis and Color3.fromRGB(80,255,120) or Color3.fromRGB(255,80,80)
            obj.wallLbl.Visible    = true
        else
            obj.wallLbl.Text    = ""
            obj.wallLbl.Visible = false
        end

        local headPos2D
        if head then
            local h2d, hOn = worldToVP(head.Position)
            headPos2D = hOn and h2d or nil
        end
        local rootPos2D, rootOn = worldToVP(root.Position)

        if showLine and rootOn then
            drawLine(obj.espLine, lineOrigin, rootPos2D, 1.2)
        else
            obj.espLine.Visible = false
        end

        -- v14: throttle skeleton update riêng (nặng nhất)
        local doBone = (now - _lastBoneUpdate >= CONFIG.RENDER_BONE_INTERVAL)
        for i, bonePair in ipairs(BONES) do
            local bLine = obj.bones[i]
            if not bLine then continue end
            if showSkel and doBone then
                local p1 = char:FindFirstChild(bonePair[1])
                local p2 = char:FindFirstChild(bonePair[2])
                if p1 and p2 then
                    local a2d, on1 = worldToVP(p1.Position)
                    local b2d, on2 = worldToVP(p2.Position)
                    if on1 or on2 then
                        drawLine(bLine, a2d, b2d, 1.2)
                    else
                        bLine.Visible = false
                    end
                else
                    bLine.Visible = false
                end
            elseif not showSkel then
                bLine.Visible = false
            end
        end
    end
    if now - _lastBoneUpdate >= CONFIG.RENDER_BONE_INTERVAL then
        _lastBoneUpdate = now
    end

    -- Cập nhật badge
    if espCountVisible > 0 then
        countLbl.Text                        = string.format("👁  Thấy: %d người", espCountVisible)
        screenBadgeFrame.BackgroundColor3    = Color3.fromRGB(10, 40, 90)
        scBadgeStroke.Color                  = Color3.fromRGB(60, 180, 255)
    else
        countLbl.Text                        = "👁  Thấy: 0 người"
        screenBadgeFrame.BackgroundColor3    = Color3.fromRGB(8, 20, 50)
        scBadgeStroke.Color                  = Color3.fromRGB(40, 100, 180)
    end
    end  -- end do ESP scope

    ::aimbot_section::
    -- AIMBOT (chạy mỗi frame, không throttle vì cần chính xác)
    if not AIM_ENABLED then
        silentAimTarget = nil
        return
    end

    local shouldAim = false
    if AIM_OPT.always then
        shouldAim = true
    elseif AIM_OPT.fireOnly then
        shouldAim = isFiring
    elseif AIM_OPT.manual then
        shouldAim = true
    end

    if not shouldAim then
        silentAimTarget = nil
        return
    end

    local center     = Vector2.new(vp.X / 2, vp.Y / 2)
    local fovPx      = getFOVpx()
    local nearPart   = nil
    local nearPlayer = nil
    local nearDist   = fovPx

    for _, player in ipairs(Players:GetPlayers()) do
        -- v13: dùng isEnemyAndVisible nếu AIM_OPT.wallcheck bật
        if AIM_OPT.wallcheck then
            if not isEnemyAndVisible(player) then continue end
        else
            if not isEnemy(player) then continue end
        end
        local char = player.Character
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end

        -- v13: ưu tiên Head nếu AIM_OPT.headAim bật
        local part
        if AIM_OPT.headAim then
            part = char:FindFirstChild("Head") or char:FindFirstChild(CONFIG.AIM_TARGET_PART)
        else
            part = char:FindFirstChild(CONFIG.AIM_TARGET_PART)
        end
        if not part then continue end

        local sp, on = worldToVP(part.Position)
        if not on then continue end
        local d = (sp - center).Magnitude
        if d < nearDist then
            nearDist   = d
            nearPart   = part
            nearPlayer = player
        end
    end

    -- Lưu target cho Silent Aim
    silentAimTarget = nearPart
    silentAimPlayer = nearPlayer

    if nearPart then
        -- v14: Silent Aim bật → KHÔNG xoay camera (Layer 3 xử lý riêng)
        if not AIM_OPT.silentAim then
            local cur = Camera.CFrame
            local tCF = CFrame.lookAt(cur.Position, nearPart.Position)
            -- v14: Adaptive smooth - gần center FOV thì lock chặt hơn
            local distRatio = math.clamp(nearDist / fovPx, 0, 1)
            -- distRatio = 0 → tâm FOV → smooth cao (lock cứng)
            -- distRatio = 1 → rìa FOV → smooth thấp hơn (kéo vào)
            local adaptiveSmooth = CONFIG.AIM_SMOOTH + (1 - distRatio) * 0.50
            adaptiveSmooth = math.clamp(adaptiveSmooth, CONFIG.AIM_SMOOTH, 0.85)
            Camera.CFrame = cur:Lerp(tCF, adaptiveSmooth)
        end
    end
end)

