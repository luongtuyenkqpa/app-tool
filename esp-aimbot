-- Hàm redirect args khi FireServer (dùng chung cho Layer 1 & 2)
local function redirectShootArgs(args)
    if not (AIM_ENABLED and AIM_OPT.silentAim and silentAimTarget) then return args, false end
    local targetPos = silentAimTarget.Position
    local replaced  = false
    for i, v in ipairs(args) do
        if typeof(v) == "Vector3" then
            -- v14: thay vị trí BẮN → vị trí target (silent aim)
            args[i]  = targetPos
            replaced = true
        elseif typeof(v) == "CFrame" then
            args[i]  = CFrame.new(targetPos)
            replaced = true
        elseif typeof(v) == "Instance" and v:IsA("BasePart") then
            args[i]  = silentAimTarget
            replaced = true
        elseif typeof(v) == "number" and v > 10 and v < 5000 then
            -- v14: Tăng tầm đạn - nếu arg là số trong range hợp lý (range/damage)
            -- chỉ boost nếu đây là "range" (dưới CONFIG.BULLET_RANGE_BOOST)
            if v < CONFIG.BULLET_RANGE_BOOST then
                args[i]  = CONFIG.BULLET_RANGE_BOOST
                replaced = true
            end
        end
    end
    return args, replaced
end

-- Layer 1: Hook global __namecall
local _saHooked = false

local function tryHookGlobalNamecall()
    if _saHooked then return end
    pcall(function()
        local mt = getrawmetatable(game)
        if not mt then return end
        local oldNc = mt.__namecall
        if not oldNc then return end
        if setreadonly then setreadonly(mt, false) end
        local function newNc(self, ...)
            local method = getnamecallmethod and getnamecallmethod() or ""
            if method == "FireServer" or method == "InvokeServer" then
                local args = {...}
                local newArgs, replaced = redirectShootArgs(args)
                if replaced then
                    return oldNc(self, table.unpack(newArgs))
                end
            end
            return oldNc(self, ...)
        end
        mt.__namecall = (newcclosure and newcclosure(newNc)) or newNc
        if setreadonly then setreadonly(mt, true) end
        _saHooked = true
    end)
end

-- Layer 2: Per-tool hook backup
local function hookToolRemotes(tool)
    if not tool or not tool:IsA("Tool") then return end
    local function patchRemote(re)
        if not re:IsA("RemoteEvent") and not re:IsA("RemoteFunction") then return end
        pcall(function()
            local mt = getrawmetatable and getrawmetatable(re)
            if not mt then return end
            local old = mt.__namecall
            if not old then return end
            if setreadonly then setreadonly(mt, false) end
            mt.__namecall = function(self, ...)
                if self == re then
                    local m = getnamecallmethod and getnamecallmethod() or ""
                    if m == "FireServer" or m == "InvokeServer" then
                        local args = {...}
                        local newArgs, replaced = redirectShootArgs(args)
                        if replaced then
                            return old(self, table.unpack(newArgs))
                        end
                    end
                end
                return old(self, ...)
            end
            if setreadonly then setreadonly(mt, true) end
        end)
    end
    for _, child in ipairs(tool:GetDescendants()) do patchRemote(child) end
    tool.DescendantAdded:Connect(patchRemote)
end

local function hookSilentAim(char)
    if not char then return end
    for _, obj in ipairs(char:GetChildren()) do
        if obj:IsA("Tool") then hookToolRemotes(obj) end
    end
    char.ChildAdded:Connect(function(obj)
        if obj:IsA("Tool") then hookToolRemotes(obj) end
    end)
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do hookToolRemotes(t) end
        bp.ChildAdded:Connect(hookToolRemotes)
    end
end

pcall(tryHookGlobalNamecall)
local function setupSilentAimForPlayer()
    local char = LocalPlayer.Character
    if char then hookSilentAim(char) end
    LocalPlayer.CharacterAdded:Connect(hookSilentAim)
end
pcall(setupSilentAimForPlayer)

-- Layer 3: Camera snap KHÔNG GIẬT v14
-- Snap camera đúng frame bắn, restore NGAY lập tức sau khi engine đọc hướng
-- Không có delay frame → camera không "nhảy" nhìn thấy được
local _prevCF     = nil
local _snapActive = false

RunService.RenderStepped:Connect(function()
    if not (AIM_ENABLED and AIM_OPT.silentAim and silentAimTarget) then
        _snapActive = false
        _prevCF     = nil
        return
    end

    if isFiring then
        -- Snap camera về địch đúng 1 frame (engine đọc CFrame để tính bullet direction)
        local cur       = Camera.CFrame
        local targetPos = silentAimTarget.Position
        _prevCF         = cur
        _snapActive     = true
        Camera.CFrame   = CFrame.lookAt(cur.Position, targetPos)
    elseif _snapActive and _prevCF then
        -- Không bắn nữa → restore ngay frame tiếp theo
        Camera.CFrame = _prevCF
        _prevCF       = nil
        _snapActive   = false
    end
end)

