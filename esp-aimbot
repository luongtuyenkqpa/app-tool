local function sliderFromInput(input)
    local trackPos  = sliderTrack.AbsolutePosition
    local trackSize = sliderTrack.AbsoluteSize
    local relX = input.Position.X - trackPos.X
    local pct  = (relX / trackSize.X) * 100
    setFOVPct(pct)
end

