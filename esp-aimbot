local espObjects = {}

local function removeESP(player)
    local obj = espObjects[player]
    if obj then
        if obj.billboard and obj.billboard.Parent then obj.billboard:Destroy() end
        for _, line in ipairs(obj.lines or {}) do
            if line.Parent then line:Destroy() end
        end
        for _, skel in ipairs(obj.skelLines or {}) do
            if skel.Parent then skel:Destroy() end
        end
        if obj.fovCircle and obj.fovCircle.Parent then obj.fovCircle:Destroy() end
    end
    espObjects[player] = nil
end

