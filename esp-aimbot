-- P1: BillboardGui/SurfaceGui trên Character
local function scanCharacterBillboards(player)
    local char = player.Character
    if not char then return nil end
    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            local t = obj.Text
            if t == "H" or t == "Hider" or t == "HIDER" then return "Hider" end
            if t == "S" or t == "Seeker" or t == "SEEKER" then return "Seeker" end
        end
    end
    return nil
end

-- P2: Attribute trên Player hoặc Character
local function scanAttributes(player)
    local attrNames = {"Role", "Team", "Side", "PlayerRole", "GameRole", "TeamName", "Job"}
    for _, attr in ipairs(attrNames) do
        local val = player:GetAttribute(attr)
        if val then
            local s = tostring(val):lower()
            if s == "h" or s:find("hider") or s:find("trốn") then return "Hider" end
            if s == "s" or s:find("seeker") or s:find("tìm") or s:find("tim") then return "Seeker" end
        end
        local char = player.Character
        if char then
            local val2 = char:GetAttribute(attr)
            if val2 then
                local s = tostring(val2):lower()
                if s == "h" or s:find("hider") then return "Hider" end
                if s == "s" or s:find("seeker") then return "Seeker" end
            end
        end
    end
    return nil
end

-- P3: leaderstats
local function scanLeaderstats(player)
    local ls = player:FindFirstChild("leaderstats")
    if not ls then return nil end
    for _, child in ipairs(ls:GetChildren()) do
        local v = tostring(child.Value):lower()
        if v == "h" or v:find("hider") then return "Hider" end
        if v == "s" or v:find("seeker") then return "Seeker" end
    end
    return nil
end

-- P4: Roblox Team service
local function scanTeam(player)
    local team = player.Team
    if not team then return nil end
    local tn = team.Name:lower()
    if tn:find("hid") or tn:find("trốn") or tn:find("blue") then return "Hider" end
    if tn:find("seek") or tn:find("tìm") or tn:find("tim") or tn:find("red") then return "Seeker" end
    local tc = team.TeamColor
    if tc then
        local r, g, b = tc.Color.R, tc.Color.G, tc.Color.B
        if b > 0.4 and b > r * 1.5 and b > g * 1.2 then return "Hider" end
        if r > 0.4 and r > b * 1.5 then return "Seeker" end
    end
    return nil
end

-- P5: Màu nhân vật (BodyColors / parts)
local function scanCharacterColor(player)
    local char = player.Character
    if not char then return nil end
    local bc = char:FindFirstChildOfClass("BodyColors")
    if bc then
        local torsoColor = bc.TorsoColor3 or bc.TorsoColor
        if torsoColor then
            local col = typeof(torsoColor) == "BrickColor" and torsoColor.Color or torsoColor
            local r, g, b = col.R, col.G, col.B
            if b > 0.35 and b > r * 1.3 then return "Hider" end
            if r > 0.35 and r > b * 1.3 then return "Seeker" end
        end
    end
    local parts = {"HumanoidRootPart", "UpperTorso", "Torso"}
    for _, pname in ipairs(parts) do
        local part = char:FindFirstChild(pname)
        if part and part:IsA("BasePart") then
            local r, g, b = part.Color.R, part.Color.G, part.Color.B
            if b > 0.35 and b > r * 1.3 then return "Hider" end
            if r > 0.35 and r > b * 1.3 then return "Seeker" end
        end
    end
    return nil
end

-- P6: PlayerGui LocalPlayer HUD scan
local hudRoleMap = {}
local lastHudScan = 0
local HUD_SCAN_INTERVAL = 1.5

local function scanLocalHUD()
    local now = tick()
    if now - lastHudScan < HUD_SCAN_INTERVAL then return end
    lastHudScan = now
    hudRoleMap = {}

    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return end

    local function deepScan(parent, depth)
        if depth > 10 then return end
        for _, child in ipairs(parent:GetChildren()) do
            if child:IsA("TextLabel") or child:IsA("TextButton") then
                local t = (child.Text or ""):match("^%s*(.-)%s*$")
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer then
                        local pname = p.Name:lower()
                        local dname = p.DisplayName:lower()
                        local tl = t:lower()
                        if tl:find(pname, 1, true) or tl:find(dname, 1, true) then
                            if tl:find("%bh%b") or tl:find("hider") then
                                hudRoleMap[p.Name] = "Hider"
                            elseif tl:find("%bs%b") or tl:find("seeker") then
                                hudRoleMap[p.Name] = "Seeker"
                            end
                        end
                    end
                end
                if t == "H" or t == "Hider" or t == "HIDER" then
                    local sib = parent
                    if sib then
                        for _, s in ipairs(sib:GetChildren()) do
                            if s ~= child and (s:IsA("TextLabel") or s:IsA("TextButton")) then
                                local st = s.Text or ""
                                for _, p in ipairs(Players:GetPlayers()) do
                                    if st:lower():find(p.Name:lower(), 1, true)
                                    or st:lower():find(p.DisplayName:lower(), 1, true) then
                                        hudRoleMap[p.Name] = "Hider"
                                    end
                                end
                            end
                        end
                    end
                elseif t == "S" or t == "Seeker" or t == "SEEKER" then
                    local sib = parent
                    if sib then
                        for _, s in ipairs(sib:GetChildren()) do
                            if s ~= child and (s:IsA("TextLabel") or s:IsA("TextButton")) then
                                local st = s.Text or ""
                                for _, p in ipairs(Players:GetPlayers()) do
                                    if st:lower():find(p.Name:lower(), 1, true)
                                    or st:lower():find(p.DisplayName:lower(), 1, true) then
                                        hudRoleMap[p.Name] = "Seeker"
                                    end
                                end
                            end
                        end
                    end
                end
            end
            deepScan(child, depth + 1)
        end
    end
    deepScan(pg, 0)
end

-- P7: Scan workspace BillboardGui
local wsRoleMap = {}
local lastWsScan = 0
local WS_SCAN_INTERVAL = 1.0

local function scanWorkspaceBillboards()
    local now = tick()
    if now - lastWsScan < WS_SCAN_INTERVAL then return end
    lastWsScan = now
    wsRoleMap = {}

    local playerNames = {}
    local displayNames = {}
    for _, p in ipairs(Players:GetPlayers()) do
        playerNames[p.Name:lower()] = p
        if p.DisplayName ~= "" then
            displayNames[p.DisplayName:lower()] = p
        end
    end

    local function scanNode(node, depth)
        if depth > 8 then return end
        for _, child in ipairs(node:GetChildren()) do
            if child:IsA("BillboardGui") or child:IsA("SurfaceGui") then
                local foundHS = nil
                local allTexts = {}
                for _, lbl in ipairs(child:GetDescendants()) do
                    if lbl:IsA("TextLabel") or lbl:IsA("TextButton") then
                        local t = (lbl.Text or ""):match("^%s*(.-)%s*$")
                        table.insert(allTexts, t)
                        if t == "H" or t == "Hider" or t == "HIDER" then foundHS = "Hider" end
                        if t == "S" or t == "Seeker" or t == "SEEKER" then foundHS = "Seeker" end
                    end
                end
                if foundHS then
                    local adornee = child.Adornee
                    if adornee then
                        local char = adornee:IsA("Model") and adornee or adornee.Parent
                        if char then
                            for _, p in ipairs(Players:GetPlayers()) do
                                if p.Character == char then
                                    wsRoleMap[p.Name] = foundHS
                                    break
                                end
                            end
                        end
                    end
                    for _, t in ipairs(allTexts) do
                        local tl = t:lower()
                        for name, p in pairs(playerNames) do
                            if tl:find(name, 1, true) then wsRoleMap[p.Name] = foundHS end
                        end
                        for dname, p in pairs(displayNames) do
                            if tl:find(dname, 1, true) then wsRoleMap[p.Name] = foundHS end
                        end
                    end
                end
            end
            if child:IsA("Model") then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.Character == child then
                        for _, desc in ipairs(child:GetDescendants()) do
                            if desc:IsA("TextLabel") or desc:IsA("TextButton") then
                                local t = (desc.Text or ""):match("^%s*(.-)%s*$")
                                if t == "H" or t == "Hider" or t == "HIDER" then
                                    wsRoleMap[p.Name] = "Hider"
                                elseif t == "S" or t == "Seeker" or t == "SEEKER" then
                                    wsRoleMap[p.Name] = "Seeker"
                                end
                            end
                        end
                        break
                    end
                end
                scanNode(child, depth + 1)
            end
        end
    end
    scanNode(workspace, 0)
end

-- P8 MỚI: Scan Highlight instance màu do game gán trực tiếp lên character
-- Game Chameleon thường gán Highlight xanh dương = Hider, đỏ/cam = Seeker
local hlRoleMap = {}  -- [playerName] = "Hider"/"Seeker"
local lastHlScan = 0
local HL_SCAN_INTERVAL = 0.8

local function scanHighlights()
    local now = tick()
    if now - lastHlScan < HL_SCAN_INTERVAL then return end
    lastHlScan = now
    hlRoleMap = {}

    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local char = p.Character
        if not char then continue end

        -- Tìm tất cả Highlight KHÔNG phải do chính script tạo
        for _, obj in ipairs(char:GetDescendants()) do
            if obj:IsA("Highlight") and obj.Name ~= "ESP_HL" then
                local fc = obj.FillColor
                local oc = obj.OutlineColor
                -- Kiểm tra màu Fill hoặc Outline
                local function checkColor(c)
                    local r, g, b = c.R, c.G, c.B
                    -- Xanh dương/xanh lá → Hider
                    if (b > 0.35 and b > r * 1.25) or (g > 0.5 and g > r * 1.4 and b > 0.3) then
                        return "Hider"
                    end
                    -- Đỏ/cam → Seeker
                    if r > 0.45 and r > b * 1.5 and r > g * 0.9 then
                        return "Seeker"
                    end
                    return nil
                end
                local role = checkColor(fc) or checkColor(oc)
                if role then
                    hlRoleMap[p.Name] = role
                    break
                end
            end
        end

        -- Cũng scan parent (workspace/model) chứa Highlight adornee = char
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Highlight") and obj.Name ~= "ESP_HL" then
                local adornee = obj.Adornee
                if adornee == char or (adornee and adornee.Parent == char) then
                    local fc = obj.FillColor
                    local oc = obj.OutlineColor
                    local function checkColor2(c)
                        local r, g, b = c.R, c.G, c.B
                        if (b > 0.35 and b > r * 1.25) or (g > 0.5 and g > r * 1.4 and b > 0.3) then
                            return "Hider"
                        end
                        if r > 0.45 and r > b * 1.5 and r > g * 0.9 then
                            return "Seeker"
                        end
                        return nil
                    end
                    local role = checkColor2(fc) or checkColor2(oc)
                    if role then
                        hlRoleMap[p.Name] = role
                        break
                    end
                end
            end
        end
    end
end

-- Tổng hợp: thử từng phương pháp
local function detectRole(player)
    local cached = roleCache[player]
    if cached and (tick() - cached.time) < ROLE_CACHE_TTL and cached.role then
        return cached.role
    end

    local role = nil

    -- P8 TRƯỚC (ưu tiên cao nhất - Highlight màu game gán)
    scanHighlights()
    local hlRole = hlRoleMap[player.Name]
    if hlRole then
        roleCache[player] = {role = hlRole, time = tick()}
        return hlRole
    end

    -- P1: Billboard character
    role = scanCharacterBillboards(player)
    if role then
        roleCache[player] = {role = role, time = tick()}
        return role
    end

    -- P2: Attributes
    role = scanAttributes(player)
    if role then
        roleCache[player] = {role = role, time = tick()}
        return role
    end

    -- P3: leaderstats
    role = scanLeaderstats(player)
    if role then
        roleCache[player] = {role = role, time = tick()}
        return role
    end

    -- P4: Team service
    role = scanTeam(player)
    if role then
        roleCache[player] = {role = role, time = tick()}
        return role
    end

    -- P5: Màu nhân vật
    role = scanCharacterColor(player)
    if role then
        roleCache[player] = {role = role, time = tick()}
        return role
    end

    -- P6: HUD map
    scanLocalHUD()
    local hudRole = hudRoleMap[player.Name]
    if hudRole then
        roleCache[player] = {role = hudRole, time = tick()}
        return hudRole
    end

    -- P7: Workspace BillboardGui
    scanWorkspaceBillboards()
    local wsRole = wsRoleMap[player.Name]
    if wsRole then
        roleCache[player] = {role = wsRole, time = tick()}
        return wsRole
    end

    -- Giữ cache cũ
    if cached and cached.role then
        return cached.role
    end

    return nil
end

local function getRole(player) return detectRole(player) end
local function getMyRole()     return getRole(LocalPlayer) end

Players.PlayerRemoving:Connect(function(p)
    roleCache[p] = nil
end)

local function isEnemy(player)
    if player == LocalPlayer then return false end
    local myRole    = getMyRole()
    local theirRole = getRole(player)
    if myRole and theirRole then return myRole ~= theirRole end
    if myRole and not theirRole then return true end
    if LocalPlayer.Team and player.Team then
        return LocalPlayer.Team ~= player.Team
    end
    return true
end

