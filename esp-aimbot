local function rebuildESP()
    for _, p in ipairs(Players:GetPlayers()) do removeESP(p) end
    if not ESP_ON then return end
    task.wait(0.15)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then addESP(p) end
    end
end

