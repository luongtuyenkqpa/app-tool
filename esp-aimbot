-- TOGGLE FACTORY (FIX: trả về setter/getter dùng biến ngoài)
-- makeToggle KHÔNG tự quản lý state nữa
-- Caller truyền vào getter/setter của biến ngoài
--==================================================

local function makeToggle(parent, label, xPos, yPos, width, getState, setState)
    local btn = Instance.new("TextButton", parent)
    btn.Size             = UDim2.fromOffset(width, 44)
    btn.Position         = UDim2.fromOffset(xPos, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(35, 35, 52)
    btn.AutoButtonColor  = false
    btn.BorderSizePixel  = 0
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 12)

    local lbl2 = Instance.new("TextLabel", btn)
    lbl2.Size             = UDim2.new(1, -56, 1, 0)
    lbl2.Position         = UDim2.fromOffset(10, 0)
    lbl2.BackgroundTransparency = 1
    lbl2.Text             = label
    lbl2.TextColor3       = Color3.new(1, 1, 1)
    lbl2.TextSize         = 13
    lbl2.Font             = Enum.Font.GothamBold
    lbl2.TextXAlignment   = Enum.TextXAlignment.Left

    local pill = Instance.new("Frame", btn)
    pill.Size             = UDim2.fromOffset(40, 22)
    pill.Position         = UDim2.new(1, -48, 0.5, -11)
    pill.BackgroundColor3 = Color3.fromRGB(70, 70, 95)
    pill.BorderSizePixel  = 0
    Instance.new("UICorner", pill).CornerRadius = UDim.new(0.5, 0)

    local dot = Instance.new("Frame", pill)
    dot.Size             = UDim2.fromOffset(16, 16)
    dot.Position         = UDim2.fromOffset(3, 3)
    dot.BackgroundColor3 = Color3.new(1, 1, 1)
    dot.BorderSizePixel  = 0
    Instance.new("UICorner", dot).CornerRadius = UDim.new(0.5, 0)

    -- Cập nhật visual từ state ngoài
    local function refreshVisual()
        local on = getState()
        local ti = TweenInfo.new(0.15)
        TweenService:Create(pill, ti, {
            BackgroundColor3 = on
                and Color3.fromRGB(80, 200, 120)
                or  Color3.fromRGB(70, 70, 95)
        }):Play()
        TweenService:Create(dot, ti, {
            Position = on
                and UDim2.fromOffset(21, 3)
                or  UDim2.fromOffset(3, 3)
        }):Play()
    end

    -- FIX: click → đổi biến ngoài → cập nhật visual
    btn.Activated:Connect(function()
        setState(not getState())
        refreshVisual()
    end)

    return btn, refreshVisual  -- trả về btn và hàm để caller có thể force-refresh
end

