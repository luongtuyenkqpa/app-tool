-- P8 MỚI: Scan Highlight instance màu do game gán trực tiếp lên character
-- Game Chameleon thường gán Highlight xanh dương = Hider, đỏ/cam = Seeker
local hlRoleMap = {}  -- [playerName] = "Hider"/"Seeker"
local lastHlScan = 0
local HL_SCAN_INTERVAL = 0.8

local function scanHighlights()
    local now = tick()
    if now - lastHlScan < HL_SCAN_INTERVAL then return end
    lastHlScan = now
    hlRoleMap = {}

    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local char = p.Character
        if not char then continue end

        -- Tìm tất cả Highlight KHÔNG phải do chính script tạo
        for _, obj in ipairs(char:GetDescendants()) do
            if obj:IsA("Highlight") and obj.Name ~= "ESP_HL" then
                local fc = obj.FillColor
                local oc = obj.OutlineColor
                -- Kiểm tra màu Fill hoặc Outline
                local function checkColor(c)
                    local r, g, b = c.R, c.G, c.B
                    -- Xanh dương/xanh lá → Hider
                    if (b > 0.35 and b > r * 1.25) or (g > 0.5 and g > r * 1.4 and b > 0.3) then
                        return "Hider"
                    end
                    -- Đỏ/cam → Seeker
                    if r > 0.45 and r > b * 1.5 and r > g * 0.9 then
                        return "Seeker"
                    end
                    return nil
                end
                local role = checkColor(fc) or checkColor(oc)
                if role then
                    hlRoleMap[p.Name] = role
                    break
                end
            end
        end

        -- Cũng scan parent (workspace/model) chứa Highlight adornee = char
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Highlight") and obj.Name ~= "ESP_HL" then
                local adornee = obj.Adornee
                if adornee == char or (adornee and adornee.Parent == char) then
                    local fc = obj.FillColor
                    local oc = obj.OutlineColor
                    local function checkColor2(c)
                        local r, g, b = c.R, c.G, c.B
                        if (b > 0.35 and b > r * 1.25) or (g > 0.5 and g > r * 1.4 and b > 0.3) then
                            return "Hider"
                        end
                        if r > 0.45 and r > b * 1.5 and r > g * 0.9 then
                            return "Seeker"
                        end
                        return nil
                    end
                    local role = checkColor2(fc) or checkColor2(oc)
                    if role then
                        hlRoleMap[p.Name] = role
                        break
                    end
                end
            end
        end
    end
end

-- v13: VOTE SYSTEM - Tổng hợp tất cả phương pháp, vote đa số
-- Trọng số: P8(Highlight)=4, P1(Billboard)=4, P2(Attr)=3, P9(IntValue)=3,
--           P3(Leaderstats)=2, P4(Team)=2, P7(WsBoard)=2, P6(HUD)=1, P5(Color)=1
local function detectRole(player)
    local cached = roleCache[player]
    if cached and (tick() - cached.time) < ROLE_CACHE_TTL and cached.role then
        return cached.role
    end

    -- Chạy tất cả scan cần thiết
    scanHighlights()
    scanLocalHUD()
    scanWorkspaceBillboards()
    scanIntValues()

    local votes = {Hider = 0, Seeker = 0}
    local function addVote(role, weight)
        if role == "Hider" or role == "Seeker" then
            votes[role] = votes[role] + (weight or 1)
        end
    end

    -- P8: Highlight màu (weight 4)
    addVote(hlRoleMap[player.Name], 4)

    -- P1: Billboard character (weight 4)
    addVote(scanCharacterBillboards(player), 4)

    -- P2: Attributes (weight 3)
    addVote(scanAttributes(player), 3)

    -- P9: IntValue/StringValue (weight 3)
    addVote(ivRoleMap[player.Name], 3)

    -- P3: leaderstats (weight 2)
    addVote(scanLeaderstats(player), 2)

    -- P4: Team service (weight 2)
    addVote(scanTeam(player), 2)

    -- P7: Workspace BillboardGui (weight 2)
    addVote(wsRoleMap[player.Name], 2)

    -- P6: HUD (weight 1)
    addVote(hudRoleMap[player.Name], 1)

    -- P5: Màu nhân vật (weight 1)
    addVote(scanCharacterColor(player), 1)

    -- Quyết định: cần ít nhất 2 vote, và phải vượt hơn đội kia ít nhất 1
    local winner = nil
    if votes.Hider >= 2 and votes.Hider > votes.Seeker then
        winner = "Hider"
    elseif votes.Seeker >= 2 and votes.Seeker > votes.Hider then
        winner = "Seeker"
    elseif votes.Hider == 1 and votes.Seeker == 0 then
        winner = "Hider"  -- chỉ có 1 vote nhưng đủ tin
    elseif votes.Seeker == 1 and votes.Hider == 0 then
        winner = "Seeker"
    end

    if winner then
        roleCache[player] = {role = winner, time = tick(), votes = votes}
        return winner
    end

    -- Giữ cache cũ nếu chưa expire hẳn (trong 5s)
    if cached and cached.role and (tick() - cached.time) < 5.0 then
        return cached.role
    end

    return nil
end

-- v13: Realtime attribute listener - invalidate cache ngay khi attribute thay đổi
local function setupRoleListener(player)
    if roleListeners[player] then return end  -- đã setup rồi
    local conns = {}
    local function invalidate()
        roleCache[player] = nil  -- force re-detect ngay lần sau
    end
    -- Lắng nghe attribute changed trên Player
    table.insert(conns, player.AttributeChanged:Connect(invalidate))
    -- Lắng nghe character
    local function watchChar(char)
        if not char then return end
        table.insert(conns, char.AttributeChanged:Connect(invalidate))
        -- Watch ChildAdded trên char để bắt IntValue/StringValue mới
        table.insert(conns, char.ChildAdded:Connect(function(child)
            local n = child.Name:lower()
            if n == "role" or n == "team" or n == "side" or n == "playerrole" then
                if child:IsA("ValueBase") then
                    table.insert(conns, child:GetPropertyChangedSignal("Value"):Connect(invalidate))
                end
            end
        end))
    end
    if player.Character then watchChar(player.Character) end
    table.insert(conns, player.CharacterAdded:Connect(watchChar))
    roleListeners[player] = conns
end

Players.PlayerAdded:Connect(function(p)
    setupRoleListener(p)
end)
Players.PlayerRemoving:Connect(function(p)
    -- Cleanup listeners
    local conns = roleListeners[p]
    if conns then
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        roleListeners[p] = nil
    end
end)
-- Setup cho players đã online
for _, p in ipairs(Players:GetPlayers()) do
    setupRoleListener(p)
end

local function getRole(player) return detectRole(player) end
local function getMyRole()     return getRole(LocalPlayer) end

Players.PlayerRemoving:Connect(function(p)
    roleCache[p] = nil
end)

-- v14: isEnemy STRICT - không bao giờ show đồng đội
-- Logic: chỉ hiện nếu CHẮC CHẮN là kẻ địch (role khác), còn lại ẩn
local function isEnemy(player)
    if player == LocalPlayer then return false end
    local myRole    = getMyRole()
    local theirRole = getRole(player)

    -- TRƯỜNG HỢP 1: Biết cả 2 role → so sánh thẳng
    if myRole and theirRole then
        return myRole ~= theirRole
    end

    -- TRƯỜNG HỢP 2: Biết role mình, chưa biết họ
    if myRole then
        -- Mình là Hider: Hider ẩn náu, Seeker truy đuổi → chưa rõ thì KHÔNG hiện (tránh show đồng đội)
        if myRole == "Hider" then return false end
        -- Mình là Seeker: các Hider là mục tiêu → chưa rõ có thể hiện (Hider ẩn chưa detect được)
        -- NHƯNG v14: nếu đang có nhiều đồng đội S hiện trong HUD → kiểm tra bằng team service trước
        if myRole == "Seeker" then
            -- Ưu tiên kiểm tra Team service để tránh show đồng đội S
            if LocalPlayer.Team and player.Team then
                return LocalPlayer.Team ~= player.Team
            end
            -- Chưa có team service → hiện (khả năng là Hider chưa detect)
            return true
        end
    end

    -- TRƯỜNG HỢP 3: Không biết role mình
    -- Dùng Roblox Team service
    if LocalPlayer.Team and player.Team then
        return LocalPlayer.Team ~= player.Team
    end

    -- TRƯỜNG HỢP 4: Không có đủ thông tin → AN TOÀN: KHÔNG hiện
    -- v14: đổi từ return true → return false để tránh show đồng đội
    return false
end

-- Hàm kiểm tra có phải kẻ địch VÀ đang ngoài tường không (cho Aimbot)
local function isEnemyAndVisible(player)
    if not isEnemy(player) then return false end
    if AIM_OPT.wallcheck then
        return isPlayerVisible(player)
    end
    return true
end

--==================================================
-- CHECK TƯỜNG v14 - Multi-Point Raycast
-- Bắn 5 tia từ mắt mình đến 5 điểm khác nhau trên người địch
-- Chỉ cần 1 tia xuyên qua → coi là thấy được (more accurate)
--==================================================

local wallCache     = {}
local WALL_INTERVAL = 0.08   -- v14: giảm interval → phản hồi nhanh hơn

local function isPlayerVisible(targetPlayer)
    local now = tick()
    local cache = wallCache[targetPlayer]
    if cache and (now - cache.lastCheck) < WALL_INTERVAL then
        return cache.visible
    end

    local myChar = LocalPlayer.Character
    if not myChar then
        wallCache[targetPlayer] = {visible = false, lastCheck = now}
        return false
    end
    local myEye = myChar:FindFirstChild("Head") or myChar:FindFirstChild("HumanoidRootPart")
    if not myEye then
        wallCache[targetPlayer] = {visible = false, lastCheck = now}
        return false
    end

    local targetChar = targetPlayer.Character
    if not targetChar then
        wallCache[targetPlayer] = {visible = false, lastCheck = now}
        return false
    end

    -- v14: Thu thập nhiều điểm mục tiêu trên người địch
    local checkParts = {"Head", "HumanoidRootPart", "UpperTorso", "Torso", "LeftUpperArm", "RightUpperArm"}
    local targetPoints = {}
    for _, pname in ipairs(checkParts) do
        local p = targetChar:FindFirstChild(pname)
        if p and p:IsA("BasePart") then
            table.insert(targetPoints, p.Position)
            if #targetPoints >= 5 then break end  -- tối đa 5 điểm
        end
    end
    if #targetPoints == 0 then
        wallCache[targetPlayer] = {visible = false, lastCheck = now}
        return false
    end

    local origin = myEye.Position
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {myChar, targetChar}
    rayParams.FilterType = Enum.RaycastFilterType.Exclude

    -- Bắn 1 tia đến mỗi điểm, chỉ cần 1 xuyên qua → visible
    for _, targetPos in ipairs(targetPoints) do
        local direction = targetPos - origin
        local result = workspace:Raycast(origin, direction, rayParams)
        if result == nil then
            -- Không có vật cản → thấy được
            wallCache[targetPlayer] = {visible = true, lastCheck = now}
            return true
        end
    end

    -- Tất cả tia đều bị chặn → sau tường
    wallCache[targetPlayer] = {visible = false, lastCheck = now}
    return false
end

