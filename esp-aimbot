--==================================================
-- TEAM DETECT (Dogs of War: xanh lá vs đỏ cam)
-- Đội xanh (Star) vs Đội đỏ (Iron)
--==================================================
local teamCache = {}
local teamTime  = {}
local CACHE_TTL = 3.0

local function clearTeamCache(p) teamCache[p]=nil teamTime[p]=nil end

-- P1: Roblox Team service (DoW dùng Teams)
local function detectViaTeam(player)
    local t = player.Team
    if not t then return nil end
    local tn = t.Name:lower()
    if tn:find("star") or tn:find("green") or tn:find("xanh") then return "Star" end
    if tn:find("iron") or tn:find("red")  or tn:find("đỏ")   then return "Iron" end
    -- TeamColor fallback
    local ok, col = pcall(function() return t.TeamColor.Color end)
    if ok and col then
        if col.G > 0.4 and col.G > col.R * 1.3 then return "Star" end
        if col.R > 0.4 and col.R > col.G * 1.3 then return "Iron" end
    end
    return nil
end

-- P2: Character tags / attributes
local ATTR_KEYS = {"Team","Side","Faction","Camp","Role"}
local function detectViaAttr(player)
    local sources = {player, player.Character}
    for _, src in ipairs(sources) do
        if not src then continue end
        for _, k in ipairs(ATTR_KEYS) do
            local ok, v = pcall(function() return src:GetAttribute(k) end)
            if ok and v then
                local s = tostring(v):lower()
                if s:find("star") or s:find("green") then return "Star" end
                if s:find("iron") or s:find("red")   then return "Iron" end
            end
        end
    end
    return nil
end

-- P3: Workspace grouping
local function detectViaFolder(player)
    local char = player.Character
    if not char then return nil end
    local par = char.Parent
    if not par or par == workspace then return nil end
    local n = par.Name:lower()
    if n:find("star") or n:find("green") then return "Star" end
    if n:find("iron") or n:find("red")   then return "Iron" end
    return nil
end

-- P4: leaderstats
local function detectViaLeaderstats(player)
    local ls = player:FindFirstChild("leaderstats")
    if not ls then return nil end
    for _, child in ipairs(ls:GetChildren()) do
        local v = tostring(child.Value):lower()
        if v:find("star") then return "Star" end
        if v:find("iron") then return "Iron" end
    end
    return nil
end

local function getTeam(player)
    local cached = teamCache[player]
    if cached and teamTime[player] and (tick()-teamTime[player]) < CACHE_TTL then
        return cached
    end
    local function cache(r)
        if r then teamCache[player]=r teamTime[player]=tick() end
        return r
    end
    local r
    r = detectViaTeam(player);        if r then return cache(r) end
    r = detectViaAttr(player);         if r then return cache(r) end
    r = detectViaFolder(player);       if r then return cache(r) end
    r = detectViaLeaderstats(player);  if r then return cache(r) end
    -- fallback: sama TeamColor HRP
    if cached then return cached end
    return nil
end

local function getMyTeam() return getTeam(LocalPlayer) end

local function isEnemy(player)
    if player == LocalPlayer then return false end
    local mt = getMyTeam()
    local tt = getTeam(player)
    if mt and tt then return mt ~= tt end
    if LocalPlayer.Team and player.Team then return LocalPlayer.Team ~= player.Team end
    return true
end

-- Reset cache khi character đổi
local function hookPlayer(p)
