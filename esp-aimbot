        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and isEnemy(p) then addESP(p) end
        end
    else
        for _, p in ipairs(Players:GetPlayers()) do removeESP(p) end
        espCount = 0
        countLbl.Text = "👁  ESP: 0 người"
    end
end)

