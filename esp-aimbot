RunService.Heartbeat:Connect(function()
    local now = tick()
    vp = Camera.ViewportSize

    -- Đếm server count mỗi 1 giây
    if now - lastCountTick >= COUNT_INTERVAL then
        lastCountTick = now
        updateServerCount()
        hudFrame.Visible = ESP_ENABLED
    end
end)

local vp = Camera.ViewportSize

RunService.RenderStepped:Connect(function()
    vp = Camera.ViewportSize
    local lineOrigin = Vector2.new(vp.X / 2, 0)

    espCountVisible = 0

    fovFrame.Visible = AIM_ENABLED and OPT.fov

    -- Role label
    local myRole = getMyRole()
    if myRole == "Seeker" then
        roleLbl.Text       = "🔎 Người Tìm (S)"
        roleLbl.TextColor3 = Color3.fromRGB(255, 100, 100)
    elseif myRole == "Hider" then
        roleLbl.Text       = "🫣 Người Trốn (H)"
        roleLbl.TextColor3 = Color3.fromRGB(100, 200, 255)
    else
        roleLbl.Text       = "❓ Xác định..."
        roleLbl.TextColor3 = Color3.fromRGB(180, 180, 100)
    end

    if myRole ~= lastMyRole then
        lastMyRole = myRole
        if ESP_ENABLED then rebuildAllESP() end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end

        local obj = espObjects[player]

        if obj and obj.char ~= player.Character then
            removeESP(player)
            obj = nil
        end

        if not ESP_ENABLED or not isEnemy(player) then
            if obj then
                if obj.hl      then obj.hl.Enabled = false end
                if obj.bbg     then obj.bbg.Enabled = false end
                if obj.espLine then obj.espLine.Visible = false end
                for _, b in ipairs(obj.bones or {}) do b.Visible = false end
            end
            continue
        end

        local char = player.Character
        if not char then continue end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then continue end

        local dist = getDistanceTo(player)
        if dist > CONFIG.ESP_MAX_DISTANCE then
            if obj then
                if obj.hl      then obj.hl.Enabled  = false end
                if obj.bbg     then obj.bbg.Enabled  = false end
                if obj.espLine then obj.espLine.Visible = false end
                for _, b in ipairs(obj.bones or {}) do b.Visible = false end
            end
            continue
        end

        espCountVisible = espCountVisible + 1

        if not obj then
            addESP(player)
            obj = espObjects[player]
        end
        if not obj then continue end

        -- Wall check dùng cache (không raycast mỗi frame)
        local visible = OPT.wallcheck and isPlayerVisible(player) or true
        local espColor
        if OPT.wallcheck then
            espColor = visible and CONFIG.ESP_COLOR_VISIBLE or CONFIG.ESP_COLOR_THROUGH_WALL
        else
            espColor = CONFIG.ESP_COLOR_ENEMY
        end

        if obj.hl then
            obj.hl.FillColor    = espColor
            obj.hl.OutlineColor = espColor
        end
        if obj.nameLbl then
            obj.nameLbl.TextColor3 = espColor
        end
        if obj.espLine then
            obj.espLine.BackgroundColor3 = espColor
        end

        if obj.wallLbl then
            if OPT.wallcheck then
                obj.wallLbl.Text       = visible and "✅ Ngoài tường" or "🧱 Trong tường"
                obj.wallLbl.TextColor3 = visible and Color3.fromRGB(80, 220, 100) or Color3.fromRGB(255, 60, 60)
                obj.wallLbl.Visible    = true
            else
                obj.wallLbl.Visible = false
            end
        end

        local showBox  = OPT.box
        local showName = OPT.name
        local showDist = OPT.dist
        local showSkel = OPT.skeleton
        local showLine = OPT.lines

        if obj.hl then obj.hl.Enabled = showBox end

        if obj.bbg then
            obj.bbg.Enabled = showName or showDist or OPT.wallcheck
            if obj.nameLbl then obj.nameLbl.Visible = showName end
            if obj.distLbl then
                obj.distLbl.Visible = showDist
                if showDist then
                    obj.distLbl.Text = string.format("📏 %.0f m", dist)
                end
            end
        end

        if obj.espLine then
            if showLine then
                local rp2d, on = worldToVP(root.Position)
                if on then
                    drawLine(obj.espLine, lineOrigin, rp2d, 1.5)
                else
                    obj.espLine.Visible = false
                end
            else
                obj.espLine.Visible = false
            end
        end

        for i, bonePair in ipairs(BONES) do
            local bLine = obj.bones[i]
            if not bLine then continue end
            if showSkel then
                local p1 = char:FindFirstChild(bonePair[1])
                local p2 = char:FindFirstChild(bonePair[2])
                if p1 and p2 then
                    local a2d, on1 = worldToVP(p1.Position)
                    local b2d, on2 = worldToVP(p2.Position)
                    if on1 or on2 then
                        drawLine(bLine, a2d, b2d, 1.2)
                    else
                        bLine.Visible = false
                    end
                else
                    bLine.Visible = false
                end
            else
                bLine.Visible = false
            end
        end
    end

    -- Update badge trong menu
    if espCountVisible > 0 then
        countLbl.Text               = string.format("👁  Thấy: %d người", espCountVisible)
        countBadge.BackgroundColor3 = Color3.fromRGB(20, 50, 100)
    else
        countLbl.Text               = "👁  Thấy: 0 người"
        countBadge.BackgroundColor3 = Color3.fromRGB(15, 18, 36)
    end

    -- AIMBOT
    if not AIM_ENABLED then return end

    local center   = Vector2.new(vp.X / 2, vp.Y / 2)
    local fovPx    = getFOVpx()
    local nearPart = nil
    local nearDist = fovPx

    for _, player in ipairs(Players:GetPlayers()) do
        if not isEnemy(player) then continue end
        local char = player.Character
        if not char then continue end
        local part = char:FindFirstChild(CONFIG.AIM_TARGET_PART)
        if not part then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local sp, on = worldToVP(part.Position)
        if not on then continue end
        local d = (sp - center).Magnitude
        if d < nearDist then
            nearDist = d
            nearPart = part
        end
    end

    if nearPart then
        local cur = Camera.CFrame
        local tCF = CFrame.lookAt(cur.Position, nearPart.Position)
        Camera.CFrame = cur:Lerp(tCF, CONFIG.AIM_SMOOTH)
    end
end)

