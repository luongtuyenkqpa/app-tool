--==================================================
-- DETECT TEAM - CHAMELEON SPECIFIC
--==================================================

local function scanChameleonRole(player)
    local pg = player:FindFirstChild("PlayerGui")
    if pg then
        local function deepSearch(parent, depth)
            if depth > 6 then return nil end
            for _, child in ipairs(parent:GetChildren()) do
                if child:IsA("TextLabel") or child:IsA("TextButton") then
                    local t = child.Text
                    if t == "H" or t == "Hider" then return "Hider" end
                    if t == "S" or t == "Seeker" then return "Seeker" end
                end
                local found = deepSearch(child, depth + 1)
                if found then return found end
            end
            return nil
        end
        local role = deepSearch(pg, 0)
        if role then return role end
    end

    local ls = player:FindFirstChild("leaderstats")
    if ls then
        local roleVal = ls:FindFirstChild("Role") or ls:FindFirstChild("Team")
            or ls:FindFirstChild("Side") or ls:FindFirstChild("Job")
        if roleVal then
            local v = tostring(roleVal.Value)
            if v:lower():find("hider") or v == "H" then return "Hider" end
            if v:lower():find("seeker") or v == "S" then return "Seeker" end
        end
    end

    local attrs = {"Role", "Team", "Side", "PlayerRole", "GameRole"}
    for _, attr in ipairs(attrs) do
        local val = player:GetAttribute(attr)
        if val then
            local s = tostring(val):lower()
            if s:find("hid") or s == "h" then return "Hider" end
            if s:find("seek") or s == "s" then return "Seeker" end
        end
        local char = player.Character
        if char then
            local val2 = char:GetAttribute(attr)
            if val2 then
                local s = tostring(val2):lower()
                if s:find("hid") or s == "h" then return "Hider" end
                if s:find("seek") or s == "s" then return "Seeker" end
            end
        end
    end

    local team = player.Team
    if team then
        local tn = team.Name:lower()
        if tn:find("hid") then return "Hider" end
        if tn:find("seek") then return "Seeker" end
    end

    return nil
end

local function getRole(player)
    return scanChameleonRole(player)
end

local function getMyRole()
    return getRole(LocalPlayer)
end

local function isEnemy(player)
    if player == LocalPlayer then return false end
    local myRole    = getMyRole()
    local theirRole = getRole(player)
    if myRole and theirRole then
        return myRole ~= theirRole
    end
    if LocalPlayer.Team and player.Team then
        return LocalPlayer.Team ~= player.Team
    end
    return true
end

