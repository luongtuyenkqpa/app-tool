local function drawLine(f, from2D, to2D, thick)
    local d = to2D - from2D
    local len = d.Magnitude
    if len < 1 then f.Visible = false; return end
    f.Size     = UDim2.fromOffset(len, thick or 1.5)
    f.Position = UDim2.fromOffset((from2D.X+to2D.X)/2, (from2D.Y+to2D.Y)/2)
    f.Rotation = math.deg(math.atan2(d.Y, d.X))
    f.Visible  = true
end

local function removeESP(player)
    local obj = espObjects[player]
    if not obj then return end
    if obj.hl      then obj.hl:Destroy() end
    if obj.bbg     then obj.bbg:Destroy() end
    if obj.espLine then obj.espLine:Destroy() end
    for _, b in ipairs(obj.bones or {}) do b:Destroy() end
    espObjects[player] = nil
    wallCache[player]  = nil
end

local function addESP(player)
    removeESP(player)
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    -- Màu ESP theo phe của bản thân:
    -- Nếu mình là Hider → Seeker (người tìm) = đỏ (kẻ thù)
    -- Nếu mình là Seeker → Hider (người trốn) = vàng (mục tiêu săn)
    -- Chưa xác định role → màu xanh dương mặc định
    local role   = getRole(player)
    local myRole = getMyRole()
    local col
    if role == "Seeker" then
        col = CONFIG.ESP_COLOR_ENEMY         -- đỏ: người tìm
    elseif role == "Hider" then
        col = CONFIG.ESP_COLOR_HIDER_ESP     -- vàng: người trốn
    else
        col = CONFIG.ESP_COLOR_ALLY          -- xanh = chưa rõ
    end

    local hl = Instance.new("Highlight")
    hl.Name                = "ESP_HL"
    hl.Adornee             = char
    hl.FillColor           = col
    hl.OutlineColor        = col
    hl.FillTransparency    = CONFIG.ESP_FILL_TRANSPARENCY
    hl.OutlineTransparency = 0
    hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent              = char

    local bbg = Instance.new("BillboardGui", gui)
    bbg.Adornee     = root
    bbg.Size        = UDim2.fromOffset(190, 50)
    bbg.StudsOffset = Vector3.new(0, 3.2, 0)
    bbg.AlwaysOnTop = true

    local nameLbl = Instance.new("TextLabel", bbg)
    nameLbl.Size                   = UDim2.new(1, 0, 0.54, 0)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Text                   = player.DisplayName ~= "" and player.DisplayName or player.Name
    nameLbl.TextColor3             = col
    nameLbl.TextStrokeTransparency = 0.4
    nameLbl.TextStrokeColor3       = Color3.new(0,0,0)
    nameLbl.TextSize               = CONFIG.NAME_TAG_SIZE + 2
    nameLbl.Font                   = Enum.Font.GothamBold

    local distLbl = Instance.new("TextLabel", bbg)
    distLbl.Size                   = UDim2.new(1, 0, 0.46, 0)
    distLbl.Position               = UDim2.new(0, 0, 0.54, 0)
    distLbl.BackgroundTransparency = 1
    distLbl.Text                   = ""
    distLbl.TextColor3             = Color3.fromRGB(255, 240, 160)
    distLbl.TextStrokeTransparency = 0.4
    distLbl.TextStrokeColor3       = Color3.new(0,0,0)
    distLbl.TextSize               = CONFIG.NAME_TAG_SIZE
    distLbl.Font                   = Enum.Font.Gotham

    -- Role tag (H/S) bên cạnh tên
    -- H = nền vàng tối, S = nền đỏ
    local roleTag = Instance.new("TextLabel", bbg)
    roleTag.Size                   = UDim2.fromOffset(20, 20)
    roleTag.Position               = UDim2.new(1, -22, 0, 0)
    roleTag.BackgroundColor3       = role == "Seeker"
        and Color3.fromRGB(180, 40, 30)
        or (role == "Hider" and Color3.fromRGB(160, 130, 0) or Color3.fromRGB(30, 60, 120))
    roleTag.BackgroundTransparency = 0
    roleTag.Text                   = role == "Hider" and "H"
        or (role == "Seeker" and "S" or "?")
    roleTag.TextColor3             = Color3.new(1,1,1)
    roleTag.TextSize               = 11
    roleTag.Font                   = Enum.Font.GothamBold
    roleTag.TextXAlignment         = Enum.TextXAlignment.Center
    Instance.new("UICorner", roleTag).CornerRadius = UDim.new(0, 4)

    local wallLbl = Instance.new("TextLabel", bbg)
    wallLbl.Size                   = UDim2.new(1, 0, 0, 14)
    wallLbl.Position               = UDim2.new(0, 0, 1, 2)
    wallLbl.BackgroundTransparency = 1
    wallLbl.Text                   = ""
    wallLbl.TextColor3             = Color3.fromRGB(255, 80, 80)
    wallLbl.TextStrokeTransparency = 0.3
    wallLbl.TextStrokeColor3       = Color3.new(0,0,0)
    wallLbl.TextSize               = 10
    wallLbl.Font                   = Enum.Font.GothamBold

    local espLine = makeLine(col)

    local bones = {}
    for _ = 1, #BONES do
        table.insert(bones, makeLine(Color3.fromRGB(255, 255, 255)))
    end

    espObjects[player] = {
        hl      = hl,
        bbg     = bbg,
        nameLbl = nameLbl,
        distLbl = distLbl,
        wallLbl = wallLbl,
        roleTag = roleTag,
        espLine = espLine,
        bones   = bones,
        char    = char,
    }
end

local function rebuildAllESP()
    for _, p in ipairs(Players:GetPlayers()) do removeESP(p) end
    espCountVisible = 0
    if not ESP_ENABLED then return end
    task.wait(0.2)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then addESP(p) end
    end
end

