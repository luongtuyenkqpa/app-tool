local function worldToVP(pos)
    local vp = Camera.ViewportSize
    local ok, sp = pcall(function()
        return Camera:WorldToViewportPoint(pos)
    end)
    if not ok then return Vector2.zero, false end
    return Vector2.new(sp.X, sp.Y), sp.Z > 0
end

local RAYCAST_PARAMS = RaycastParams.new()
RAYCAST_PARAMS.FilterType = Enum.RaycastFilterType.Exclude

local visCache = {}  -- [player] = {result, time}
local VIS_TTL  = 0.1

local function isVisible(player)
    local cached = visCache[player]
    if cached and (tick()-cached.time) < VIS_TTL then return cached.v end

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return false end

    local exclude = {workspace}
    if myChar then table.insert(exclude, myChar) end
    RAYCAST_PARAMS.FilterDescendantsInstances = exclude

    local origin = myRoot.Position
    local target = root.Position
    local dir    = target - origin

    local result = workspace:Raycast(origin, dir, RAYCAST_PARAMS)
    local visible = result == nil or result.Instance:IsDescendantOf(char)
    visCache[player] = {v = visible, time = tick()}
    return visible
end

local function getDist(player)
    local char   = player.Character
    local root   = char and char:FindFirstChild("HumanoidRootPart")
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not root or not myRoot then return 9999 end
    return (root.Position - myRoot.Position).Magnitude
end

local function getHealth(player)
    local char = player.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return 0, 100 end
    return hum.Health, hum.MaxHealth
end

