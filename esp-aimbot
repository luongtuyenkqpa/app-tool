local function makeToggle(parent, label, xPos, yPos, width, getState, setState)
    local btn = Instance.new("TextButton", parent)
    btn.Size             = UDim2.fromOffset(width, 46)
    btn.Position         = UDim2.fromOffset(xPos, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(18, 22, 42)
    btn.AutoButtonColor  = false
    btn.BorderSizePixel  = 0
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 12)
    local bS = Instance.new("UIStroke", btn)
    bS.Color = Color3.fromRGB(45, 65, 130)
    bS.Thickness = 1

    local lbl2 = Instance.new("TextLabel", btn)
    lbl2.Size             = UDim2.new(1, -58, 1, 0)
    lbl2.Position         = UDim2.fromOffset(10, 0)
    lbl2.BackgroundTransparency = 1
    lbl2.Text             = label
    lbl2.TextColor3       = Color3.new(1, 1, 1)
    lbl2.TextSize         = 13
    lbl2.Font             = Enum.Font.GothamBold
    lbl2.TextXAlignment   = Enum.TextXAlignment.Left

    local pill = Instance.new("Frame", btn)
    pill.Size             = UDim2.fromOffset(42, 22)
    pill.Position         = UDim2.new(1, -50, 0.5, -11)
    pill.BackgroundColor3 = Color3.fromRGB(50, 50, 75)
    pill.BorderSizePixel  = 0
    Instance.new("UICorner", pill).CornerRadius = UDim.new(0.5, 0)

    local dot = Instance.new("Frame", pill)
    dot.Size             = UDim2.fromOffset(16, 16)
    dot.Position         = UDim2.fromOffset(3, 3)
    dot.BackgroundColor3 = Color3.new(1, 1, 1)
    dot.BorderSizePixel  = 0
    Instance.new("UICorner", dot).CornerRadius = UDim.new(0.5, 0)

    local function refreshVisual()
        local on = getState()
        local ti = TweenInfo.new(0.15)
        TweenService:Create(pill, ti, {
            BackgroundColor3 = on and Color3.fromRGB(60, 180, 255) or Color3.fromRGB(50, 50, 75)
        }):Play()
        TweenService:Create(dot, ti, {
            Position = on and UDim2.fromOffset(23, 3) or UDim2.fromOffset(3, 3)
        }):Play()
        bS.Color = on and Color3.fromRGB(60, 180, 255) or Color3.fromRGB(45, 65, 130)
    end

    btn.Activated:Connect(function()
        setState(not getState())
        refreshVisual()
    end)

    refreshVisual()
    return btn, refreshVisual
end

