--==================================================
-- DETECT TEAM - CHAMELEON (FIX TRIỆT ĐỂ v8.1)
-- Vấn đề gốc: PlayerGui của người khác không đọc được client-side.
-- Giải pháp: dùng 5 phương pháp theo thứ tự ưu tiên, cache kết quả.
--==================================================

-- Cache role để tránh scan mỗi frame
local roleCache = {}   -- [player] = {role = "Hider"/"Seeker"/nil, time = tick()}
local ROLE_CACHE_TTL = 2.0  -- làm mới mỗi 2 giây

-- Phương pháp 1: BillboardGui/SurfaceGui trên Character của người khác
-- (game Chameleon thường render chữ H/S trên đầu nhân vật qua BillboardGui)
local function scanCharacterBillboards(player)
    local char = player.Character
    if not char then return nil end
    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            local t = obj.Text
            if t == "H" or t == "Hider" or t == "HIDER" then return "Hider" end
            if t == "S" or t == "Seeker" or t == "SEEKER" then return "Seeker" end
        end
    end
    return nil
end

-- Phương pháp 2: Attribute trên Player hoặc Character
local function scanAttributes(player)
    local attrNames = {"Role", "Team", "Side", "PlayerRole", "GameRole", "TeamName", "Job"}
    for _, attr in ipairs(attrNames) do
        local val = player:GetAttribute(attr)
        if val then
            local s = tostring(val):lower()
            if s == "h" or s:find("hider") or s:find("trốn") then return "Hider" end
            if s == "s" or s:find("seeker") or s:find("tìm") or s:find("tim") then return "Seeker" end
        end
        local char = player.Character
        if char then
            local val2 = char:GetAttribute(attr)
            if val2 then
                local s = tostring(val2):lower()
                if s == "h" or s:find("hider") then return "Hider" end
                if s == "s" or s:find("seeker") then return "Seeker" end
            end
        end
    end
    return nil
end

-- Phương pháp 3: leaderstats
local function scanLeaderstats(player)
    local ls = player:FindFirstChild("leaderstats")
    if not ls then return nil end
    for _, child in ipairs(ls:GetChildren()) do
        local v = tostring(child.Value):lower()
        if v == "h" or v:find("hider") then return "Hider" end
        if v == "s" or v:find("seeker") then return "Seeker" end
    end
    return nil
end

-- Phương pháp 4: Roblox Team service
local function scanTeam(player)
    local team = player.Team
    if not team then return nil end
    local tn = team.Name:lower()
    if tn:find("hid") or tn:find("trốn") or tn:find("blue") then return "Hider" end
    if tn:find("seek") or tn:find("tìm") or tn:find("tim") or tn:find("red") then return "Seeker" end
    -- TeamColor: Chameleon thường dùng xanh dương = Hider, đỏ = Seeker
    local tc = team.TeamColor
    if tc then
        local r, g, b = tc.Color.R, tc.Color.G, tc.Color.B
        -- Xanh dương: b >> r
        if b > 0.4 and b > r * 1.5 and b > g * 1.2 then return "Hider" end
        -- Đỏ: r >> b
        if r > 0.4 and r > b * 1.5 then return "Seeker" end
    end
    return nil
end

-- Phương pháp 5: Màu nhân vật (BodyColors / parts)
-- Chameleon gán màu thân nhân vật theo team
local function scanCharacterColor(player)
    local char = player.Character
    if not char then return nil end
    local bc = char:FindFirstChildOfClass("BodyColors")
    if bc then
        local torsoColor = bc.TorsoColor3 or bc.TorsoColor
        if torsoColor then
            local col = typeof(torsoColor) == "BrickColor" and torsoColor.Color or torsoColor
            local r, g, b = col.R, col.G, col.B
            if b > 0.35 and b > r * 1.3 then return "Hider" end
            if r > 0.35 and r > b * 1.3 then return "Seeker" end
        end
    end
    -- Fallback: kiểm tra màu HumanoidRootPart hoặc UpperTorso
    local parts = {"HumanoidRootPart", "UpperTorso", "Torso"}
    for _, pname in ipairs(parts) do
        local part = char:FindFirstChild(pname)
        if part and part:IsA("BasePart") then
            local r, g, b = part.Color.R, part.Color.G, part.Color.B
            if b > 0.35 and b > r * 1.3 then return "Hider" end
            if r > 0.35 and r > b * 1.3 then return "Seeker" end
        end
    end
    return nil
end

-- Phương pháp 6: PlayerGui của LocalPlayer chứa HUD radar
-- Game render tên tất cả players lên HUD của chính mình kèm H/S label
-- → scan HUD LocalPlayer để map tên → role
local hudRoleMap = {}  -- [playerName] = "Hider"/"Seeker"
local lastHudScan = 0
local HUD_SCAN_INTERVAL = 1.5

local function scanLocalHUD()
    local now = tick()
    if now - lastHudScan < HUD_SCAN_INTERVAL then return end
    lastHudScan = now
    hudRoleMap = {}

    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return end

    -- Tìm tất cả TextLabel có text "H" hoặc "S" rồi tìm tên player gần đó
    local function deepScan(parent, depth)
        if depth > 10 then return end
        for _, child in ipairs(parent:GetChildren()) do
            if child:IsA("TextLabel") or child:IsA("TextButton") then
                local t = (child.Text or ""):match("^%s*(.-)%s*$")
                -- Nếu label chứa tên player kèm H/S
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer then
                        local pname = p.Name:lower()
                        local dname = p.DisplayName:lower()
                        local tl = t:lower()
                        if tl:find(pname, 1, true) or tl:find(dname, 1, true) then
                            if tl:find("%bh%b") or tl:find("hider") then
                                hudRoleMap[p.Name] = "Hider"
                            elseif tl:find("%bs%b") or tl:find("seeker") then
                                hudRoleMap[p.Name] = "Seeker"
                            end
                        end
                    end
                end
                -- Label đơn H/S: xem anh chị em (sibling) có tên player không
                if t == "H" or t == "Hider" or t == "HIDER" then
                    local sib = parent
                    if sib then
                        for _, s in ipairs(sib:GetChildren()) do
                            if s ~= child and (s:IsA("TextLabel") or s:IsA("TextButton")) then
                                local st = s.Text or ""
                                for _, p in ipairs(Players:GetPlayers()) do
                                    if st:lower():find(p.Name:lower(), 1, true)
                                    or st:lower():find(p.DisplayName:lower(), 1, true) then
                                        hudRoleMap[p.Name] = "Hider"
                                    end
                                end
                            end
                        end
                    end
                elseif t == "S" or t == "Seeker" or t == "SEEKER" then
                    local sib = parent
                    if sib then
                        for _, s in ipairs(sib:GetChildren()) do
                            if s ~= child and (s:IsA("TextLabel") or s:IsA("TextButton")) then
                                local st = s.Text or ""
                                for _, p in ipairs(Players:GetPlayers()) do
                                    if st:lower():find(p.Name:lower(), 1, true)
                                    or st:lower():find(p.DisplayName:lower(), 1, true) then
                                        hudRoleMap[p.Name] = "Seeker"
                                    end
                                end
                            end
                        end
                    end
                end
            end
            deepScan(child, depth + 1)
        end
    end
    deepScan(pg, 0)
end

-- Hàm tổng hợp: thử từng phương pháp theo thứ tự
local function detectRole(player)
    -- Ưu tiên cache còn hạn
    local cached = roleCache[player]
    if cached and (tick() - cached.time) < ROLE_CACHE_TTL and cached.role then
        return cached.role
    end

    local role = nil

    -- P1: Billboard trên character (đáng tin nhất)
    role = scanCharacterBillboards(player)
    if role then
        roleCache[player] = {role = role, time = tick()}
        return role
    end

    -- P2: Attributes
    role = scanAttributes(player)
    if role then
        roleCache[player] = {role = role, time = tick()}
        return role
    end

    -- P3: leaderstats
    role = scanLeaderstats(player)
    if role then
        roleCache[player] = {role = role, time = tick()}
        return role
    end

    -- P4: Team service
    role = scanTeam(player)
    if role then
        roleCache[player] = {role = role, time = tick()}
        return role
    end

    -- P5: Màu nhân vật
    role = scanCharacterColor(player)
    if role then
        roleCache[player] = {role = role, time = tick()}
        return role
    end

    -- P6: HUD map từ scan LocalPlayer
    scanLocalHUD()
    local hudRole = hudRoleMap[player.Name]
    if hudRole then
        roleCache[player] = {role = hudRole, time = tick()}
        return hudRole
    end

    -- Giữ cache cũ (dù hết hạn) hơn là trả nil
    if cached and cached.role then
        return cached.role
    end

    return nil
end

local function getRole(player) return detectRole(player) end
local function getMyRole()     return getRole(LocalPlayer) end

-- Dọn cache khi player rời
Players.PlayerRemoving:Connect(function(p)
    roleCache[p] = nil
end)

local function isEnemy(player)
    if player == LocalPlayer then return false end
    local myRole    = getMyRole()
    local theirRole = getRole(player)
    -- Cả hai đều detect được → so sánh
    if myRole and theirRole then return myRole ~= theirRole end
    -- Chỉ detect được role của mình → ai không cùng role thì là enemy
    if myRole and not theirRole then return true end
    -- Roblox Team fallback
    if LocalPlayer.Team and player.Team then
        return LocalPlayer.Team ~= player.Team
    end
    -- Không detect được gì → coi là enemy (hiện ESP cho hết)
    return true
end

--==================================================
-- CHECK TƯỜNG - THROTTLE để chống lag
-- Chỉ raycast mỗi 0.15s mỗi player, không phải mỗi frame
--==================================================

local wallCache    = {}   -- [player] = {visible=bool, lastCheck=tick}
local WALL_INTERVAL = 0.15  -- giây giữa mỗi lần raycast

local function isPlayerVisible(targetPlayer)
    local now = tick()
    local cache = wallCache[targetPlayer]
    if cache and (now - cache.lastCheck) < WALL_INTERVAL then
        return cache.visible
    end

    local myChar = LocalPlayer.Character
    if not myChar then
        wallCache[targetPlayer] = {visible = false, lastCheck = now}
        return false
    end
    local myHead = myChar:FindFirstChild("Head") or myChar:FindFirstChild("HumanoidRootPart")
    if not myHead then
        wallCache[targetPlayer] = {visible = false, lastCheck = now}
        return false
    end

    local targetChar = targetPlayer.Character
    if not targetChar then
        wallCache[targetPlayer] = {visible = false, lastCheck = now}
        return false
    end
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    if not targetRoot then
        wallCache[targetPlayer] = {visible = false, lastCheck = now}
        return false
    end

    local origin    = myHead.Position
    local direction = (targetRoot.Position - origin)

    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {myChar, targetChar}
    rayParams.FilterType = Enum.RaycastFilterType.Exclude

    local result = workspace:Raycast(origin, direction, rayParams)
    local vis = (result == nil)

    wallCache[targetPlayer] = {visible = vis, lastCheck = now}
    return vis
end

-- Dọn cache khi player rời
Players.PlayerRemoving:Connect(function(p)
    wallCache[p] = nil
end)

