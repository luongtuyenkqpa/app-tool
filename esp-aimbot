local function getDistanceTo(player)
    local mc = LocalPlayer.Character
    if not mc then return math.huge end
    local mr = mc:FindFirstChild("HumanoidRootPart")
    local tc = player.Character
    if not tc then return math.huge end
    local tr = tc:FindFirstChild("HumanoidRootPart")
    if not mr or not tr then return math.huge end
    return (tr.Position - mr.Position).Magnitude
end

local function worldToVP(pos)
    local sp, on = Camera:WorldToViewportPoint(pos)
    return Vector2.new(sp.X, sp.Y), on
end

