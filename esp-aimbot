local lastCountTick = 0
local COUNT_INTERVAL = 1.0

local function updateServerCount()
    local now = tick()
    for p, cached in pairs(roleCache) do
        if (now - cached.time) >= ROLE_CACHE_TTL then
            roleCache[p] = nil
        end
    end
    lastWsScan  = 0
    lastHudScan = 0
    lastHlScan  = 0
    scanHighlights()
    scanWorkspaceBillboards()
    scanLocalHUD()

    local h, s, unknown = 0, 0, 0
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local r = getRole(p)
        if r == "Hider"  then h = h + 1
        elseif r == "Seeker" then s = s + 1
        else unknown = unknown + 1
        end
    end
    totalH = h
    totalS = s

    hudHNum.Text = tostring(totalH)
    hudSNum.Text = tostring(totalS)
    hudHNum.TextColor3 = totalH > 0 and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(130, 150, 180)
    hudSNum.TextColor3 = totalS > 0 and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 130, 130)

    -- Rebuild ESP màu khi role thay đổi
    if ESP_ENABLED then
        local myRole = getMyRole()
        if myRole ~= lastMyRole then
            lastMyRole = myRole
            rebuildAllESP()
        end
    end
end

