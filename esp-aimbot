    currentTab = tabName
    for _, name in ipairs(TAB_NAMES) do
        local isActive = (name == tabName)
        tabBtns[name].TextColor3 = isActive
            and Color3.fromRGB(80, 180, 255)
            or  Color3.fromRGB(120, 140, 180)
        tabBtns[name].Font = isActive and Enum.Font.GothamBold or Enum.Font.Gotham
        tabIndicators[name].Visible = isActive
        pageMap[name].Visible = isActive
    end
end

